<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crea Filtro di Vista da Selezione"
        Height="820" Width="760"
        MinHeight="650" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#F8FAFC">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#334155"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Crea Filtro di Vista da Selezione" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF"/>
                <TextBlock Text="Analisi automatica dei parametri comuni degli elementi selezionati e generazione rapida del filtro" FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Card 1: Elementi e Categorie -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CATEGORIE DEGLI ELEMENTI SELEZIONATI" FontWeight="Bold" FontSize="11" Foreground="#64748B"/>
                    <TextBlock Grid.Column="1" x:Name="lblSelectionSummary" Text="0 elementi selezionati" FontSize="11" Foreground="#0284C7" FontWeight="SemiBold"/>
                </Grid>
                <ItemsControl x:Name="icCategories">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,4">
                                <CheckBox IsChecked="{Binding IsIncluded}" Content="{Binding DisplayName}" FontWeight="Medium" Margin="0"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Card 2: Parametri e Regole Suggerite -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="PARAMETRI E REGOLE CONSIGLIATE" FontWeight="Bold" FontSize="11" Foreground="#64748B"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <RadioButton x:Name="rbAnd" Content="Tutte le regole (AND)" IsChecked="True"/>
                        <RadioButton x:Name="rbOr" Content="Almeno una regola (OR)"/>
                    </StackPanel>
                </Grid>

                <TextBox x:Name="txtSearchParam" Grid.Row="1" Height="30" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,8" FontSize="12"/>

                <!-- ListView Parametri -->
                <ListView x:Name="lvParameters" Grid.Row="2" BorderThickness="1" BorderBrush="#E2E8F0" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="#FFFFFF">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0,0,0,1" BorderBrush="#F1F5F9" Padding="4,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Checkbox Selezione Regola -->
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                                    
                                    <!-- Nome Parametro e Tipo/Istanza -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding ParamName}" FontWeight="SemiBold" Foreground="#0F172A" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ScopeText}" Foreground="#94A3B8" FontSize="10"/>
                                    </StackPanel>
                                    
                                    <!-- Badge Match (Identico o Multiplo) -->
                                    <Border Grid.Column="2" Background="{Binding MatchBgColor}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding MatchText}" Foreground="{Binding MatchFgColor}" FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                    
                                    <!-- Operatore -->
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding AvailableOperators}" SelectedItem="{Binding SelectedOperator, Mode=TwoWay}" Height="26" VerticalContentAlignment="Center" FontSize="11" Margin="0,0,6,0"/>
                                    
                                    <!-- Valore Regola -->
                                    <TextBox Grid.Column="4" Text="{Binding RuleValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center" Padding="4,0" FontSize="11"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Card 3: Configurazione Filtro e Vista -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="CONFIGURAZIONE FILTRO E VISTA" FontWeight="Bold" FontSize="11" Foreground="#64748B" Margin="0,0,0,8"/>
                
                <!-- Nome Filtro -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Nome Filtro:" VerticalAlignment="Center" FontWeight="Medium" FontSize="12" Foreground="#334155"/>
                    <TextBox x:Name="txtFilterName" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="6,0" FontSize="12"/>
                    <Button x:Name="btnRegenName" Grid.Column="2" Content="Suggerisci Nome" Margin="6,0,0,0" Padding="8,4" FontSize="11"/>
                </Grid>

                <!-- Opzioni Vista -->
                <CheckBox x:Name="chkAddToActiveView" Content="Aggiungi il filtro alla vista attiva" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,6"/>
                
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,6">
                    <WrapPanel Orientation="Horizontal">
                        <CheckBox x:Name="chkApplyColor" Content="Sovrascrivi Colore:" IsChecked="True" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="cmbColor" Width="110" Height="26" VerticalContentAlignment="Center" Margin="0,0,16,0" FontSize="11"/>
                        <CheckBox x:Name="chkSolidFill" Content="Retino Solido" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <CheckBox x:Name="chkHalftone" Content="Mezzitoni" IsChecked="False" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <CheckBox x:Name="chkVisibility" Content="Visibile" IsChecked="True" VerticalAlignment="Center"/>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="lblRulesCount" Grid.Column="0" Text="0 regole selezionate" VerticalAlignment="Center" Foreground="#64748B" FontSize="12" FontWeight="Medium"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="btnCancel" Content="Annulla" Width="90" Height="34" Margin="0,0,8,0" IsCancel="True"/>
                <Button x:Name="btnCreateFilter" Content="Crea e Applica Filtro" Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Height="34" Padding="16,0" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
