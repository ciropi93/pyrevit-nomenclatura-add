<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profondità Sezione (Sfondo Vettoriale) - CDV Tools"
        Height="610" Width="680"
        MinHeight="540" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#F8FAFC">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Profondità Sezione (Sfondo Vettoriale)" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF"/>
                <TextBlock Text="Crea e risincronizza una vista di sfondo in grigio/mezzitoni oltre la profondità della sezione madre" FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Sezione Madre Card -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="SEZIONE MADRE:" FontWeight="Bold" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox Grid.Column="1" x:Name="cmbSourceView" Height="28" VerticalContentAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                </Grid>

                <WrapPanel Margin="0,4,0,0">
                    <Border x:Name="bdrDepth1" Background="#E0F2FE" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <TextBlock x:Name="lblDepth1" Text="Profondità madre (d₁): -" FontSize="11" FontWeight="SemiBold" Foreground="#0369A1"/>
                    </Border>
                    <Border Background="#F1F5F9" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <TextBlock x:Name="lblScale" Text="Scala: -" FontSize="11" Foreground="#475569"/>
                    </Border>
                    <Border x:Name="bdrBgStatus" Background="#F1F5F9" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <TextBlock x:Name="lblBgStatus" Text="Sfondo: Non creato" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                    </Border>
                    <Border Background="#F1F5F9" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <TextBlock x:Name="lblSheetStatus" Text="Tavola: -" FontSize="11" Foreground="#475569"/>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Seconda Profondita' Card -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="SECONDA PROFONDITÀ (ZONA SFONDO)" FontWeight="Bold" FontSize="11" Foreground="#64748B" Margin="0,0,0,8"/>

                <RadioButton x:Name="rbModeTotal" Content="Profondità totale dalla sezione madre (m)" IsChecked="True"/>
                <RadioButton x:Name="rbModeAdd" Content="Estensione aggiuntiva oltre il primo piano (m)"/>

                <Grid Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="lblInputPrompt" Text="Valore (m):" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" x:Name="txtDepthValue" Height="28" VerticalContentAlignment="Center" Padding="8,0" FontSize="13" FontWeight="Bold" Text="15.0"/>
                    <TextBlock Grid.Column="2" Text="(usa il punto o la virgola per i decimali)" VerticalAlignment="Center" FontSize="11" Foreground="#64748B" Margin="10,0,0,0"/>
                </Grid>

                <Border x:Name="bdrDepthPreview" Background="#F1F5F9" CornerRadius="6" Padding="10,7">
                    <TextBlock x:Name="lblDepthPreview" Text="Primo piano: 0.00 -> - m | Sfondo grigio: -" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Opzioni Grafiche e Tavola Card -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="GRAFICA SFONDO E IMPAGINAZIONE" FontWeight="Bold" FontSize="11" Foreground="#64748B" Margin="0,0,0,6"/>
                <CheckBox x:Name="chkHalftone" Content="Applica Mezzitoni (Halftone)" IsChecked="True"/>
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="chkGreyColor" Content="Forza linee grigie sottili (spessore 1) — RGB:" IsChecked="True"/>
                    <TextBox x:Name="txtGreyRgb" Width="48" Height="24" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="8,0,0,0" FontSize="12" Text="140"/>
                    <TextBlock Text="(0=nero, 200=grigio chiaro)" VerticalAlignment="Center" FontSize="11" Foreground="#64748B" Margin="8,0,0,0"/>
                </StackPanel>
                <CheckBox x:Name="chkHideCutPatterns" Content="Nascondi retini e campiture piene (superficie e taglio) sullo sfondo" IsChecked="True"/>
                <CheckBox x:Name="chkSyncSheet" Content="Impagina / Riallinea automaticamente sovrapposta in tavola" IsChecked="True"/>
            </StackPanel>
        </Border>

        <!-- Note -->
        <TextBlock Grid.Row="4" Text="Suggerimento: se sposti la sezione madre o cambi il ritaglio, usa 'Sincronizza Tutte' per riallineare viste e tavole con un clic." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" VerticalAlignment="Top" Margin="4,0"/>

        <!-- Footer Actions -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="btnSyncAll" Content="Sincronizza Tutte (0)" Height="32" Padding="12,6" Background="#E0F2FE" BorderBrush="#7DD3FC" Foreground="#0369A1" FontWeight="SemiBold"/>
            <Button Grid.Column="2" x:Name="btnCancel" Content="Annulla" Width="90" Height="32" Margin="0,0,8,0"/>
            <Button Grid.Column="3" x:Name="btnApply" Content="Crea / Sincronizza Sfondo" Width="180" Height="32" Background="#0F172A" Foreground="#FFFFFF" FontWeight="Bold"/>
        </Grid>
    </Grid>
</Window>
