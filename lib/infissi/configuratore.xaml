<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuratore infissi"
        Height="720" Width="1120" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="12" Background="#F5F7FA">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- intestazione -->
        <Border Grid.ColumnSpan="3" Style="{StaticResource Intestazione}">
            <StackPanel>
                <TextBlock x:Name="lblTitolo" Text="Configuratore infissi" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                <TextBlock Text="Scegli uno schema, clicca le zone del disegno per cambiarle, poi imposta le misure"
                           FontSize="12" Foreground="#DCE9F5" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- schemi -->
        <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
            <TextBlock DockPanel.Dock="Top" Text="SCHEMI" Style="{StaticResource Etichetta}" Margin="0,0,0,4"/>
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button x:Name="btnSalvaSchema" Content="Salva schema"/>
                <Button x:Name="btnEliminaSchema" Content="Elimina"
                        ToolTip="Si eliminano solo gli schemi salvati da te (quelli con ★)"/>
            </WrapPanel>
            <ListBox x:Name="lstSchemi"/>
        </DockPanel>

        <!-- disegno e zone -->
        <DockPanel Grid.Row="1" Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" x:Name="txtAiuto" Style="{StaticResource Nota}" Margin="0,0,0,6"
                       Text="Prospetto visto da fuori. Clicca una zona per sceglierla, poi cambia l'anta o dividila."/>
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Scheda}" Margin="0,8,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="ANTA" Style="{StaticResource Etichetta}" Margin="0" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="cmbAnta" MinWidth="240"/>
                        <TextBlock Grid.Row="1" Text="CHIUSURA" Style="{StaticResource Etichetta}" Margin="0,6,0,0" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cmbChiusura" MinWidth="240" Margin="0,6,0,0"
                                  ToolTip="Vetrata, vetrata con pannello in basso (solo ante-porta) o cieca"/>
                    </Grid>
                    <WrapPanel>
                        <Button x:Name="btnDividiV" Content="Dividi in colonne"/>
                        <Button x:Name="btnDividiO" Content="Dividi in righe"/>
                        <Button x:Name="btnTogli" Content="Togli divisione"/>
                        <CheckBox x:Name="chkMontante" Content="Montante tra le parti" VerticalAlignment="Center"
                                  Margin="8,0,0,0"
                                  ToolTip="Senza montante le ante si chiudono una sull'altra (es. finestra a 2 ante)."/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Background="#FFFFFF" BorderBrush="#DDE3E8" BorderThickness="1" CornerRadius="6">
                <Canvas x:Name="cnvAnteprima" ClipToBounds="True" Background="#FFFFFF" Cursor="Hand"/>
            </Border>
        </DockPanel>

        <!-- dati -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Scheda}">
                    <StackPanel>
                        <TextBlock Text="CATEGORIA" Style="{StaticResource Etichetta}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="rbFinestre" Content="Finestre" Margin="0,0,16,0" GroupName="cat"/>
                            <RadioButton x:Name="rbPorte" Content="Porte" GroupName="cat"/>
                        </StackPanel>
                        <CheckBox x:Name="chkSoglia" Content="Soglia in basso" Margin="0,8,0,0"
                                  ToolTip="Spenta: niente traverso in basso, il telaio è a U e non si inciampa (porte)"/>
                        <CheckBox x:Name="chkManiglie" Content="Maniglie"
                                  ToolTip="Sul lato opposto alle cerniere, sul lato interno"/>
                        <TextBlock Text="IN PIANTA (FINESTRE)" Style="{StaticResource Etichetta}" Margin="0,10,0,4"
                                   ToolTip="Le porte hanno sempre anta aperta e arco"/>
                        <ComboBox x:Name="cmbPianta"/>
                        <TextBlock Text="NOME DELLA FAMIGLIA" Style="{StaticResource Etichetta}" Margin="0,10,0,4"/>
                        <TextBox x:Name="txtNome"/>
                        <TextBlock Text="TELAIO, MISURE ESTERNE (MM)" Style="{StaticResource Etichetta}" Margin="0,10,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Larghezza" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtLarghezza" Grid.Column="1" Margin="0,0,0,4"/>
                            <TextBlock Text="Altezza" Grid.Row="1" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtAltezza" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"/>
                        </Grid>
                        <TextBlock Text="MISURE DELLE ZONE (MM)" Style="{StaticResource Etichetta}" Margin="0,10,0,4"
                                   ToolTip="Dal bordo esterno o dall'asse precedente all'asse seguente"/>
                        <StackPanel x:Name="pnlMisure"/>
                    </StackPanel>
                </Border>

                <Expander x:Name="expOpzioni" Header="Opzioni avanzate" IsExpanded="False">
                    <Border Style="{StaticResource Scheda}" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="PROFILI (MM)" Style="{StaticResource Etichetta}" Margin="0,0,0,4"/>
                            <StackPanel x:Name="pnlProfili"/>
                            <TextBlock Text="CARTELLA DELLE FAMIGLIE" Style="{StaticResource Etichetta}" Margin="0,10,0,4"/>
                            <DockPanel>
                                <Button x:Name="btnCartella" DockPanel.Dock="Right" Content="..." Margin="6,0,0,0" Padding="8,2"/>
                                <TextBox x:Name="txtCartella"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- piede -->
        <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="btnAnnulla" Content="Annulla" Width="90" Height="32" Margin="0,0,8,0" IsCancel="True"/>
                <Button x:Name="btnCrea" Content="Crea famiglia e carica" Height="32" Style="{StaticResource Primario}"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="txtErrori" Foreground="#DC2626" TextWrapping="Wrap"/>
                <TextBlock x:Name="lblFile" FontSize="11" Foreground="#5B6B78" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
