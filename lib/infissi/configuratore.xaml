<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuratore infissi - CDV Tools"
        Height="720" Width="1120" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12" Background="#F8FAFC">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Titolo" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- catalogo -->
        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock DockPanel.Dock="Top" Text="Schemi" Style="{StaticResource Titolo}" Margin="0,0,0,4"/>
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button x:Name="btnSalvaSchema" Content="Salva schema"/>
                <Button x:Name="btnEliminaSchema" Content="Elimina"/>
            </WrapPanel>
            <ListBox x:Name="lstSchemi" BorderBrush="#CBD5E1"/>
        </DockPanel>

        <!-- anteprima e modifica delle zone -->
        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" x:Name="txtAiuto" Foreground="#64748B" TextWrapping="Wrap"
                       Text="Clicca una zona del disegno per sceglierla, poi cambia il tipo di anta o dividila."/>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Anta:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="cmbAnta" MinWidth="240"/>
                </DockPanel>
                <WrapPanel>
                    <Button x:Name="btnDividiV" Content="Dividi in colonne"/>
                    <Button x:Name="btnDividiO" Content="Dividi in righe"/>
                    <Button x:Name="btnTogli" Content="Togli divisione"/>
                    <CheckBox x:Name="chkMontante" Content="Montante tra le parti" VerticalAlignment="Center"
                              Margin="6,0,0,6"
                              ToolTip="Senza montante le ante si chiudono una sull'altra (es. finestra a 2 ante)."/>
                </WrapPanel>
            </StackPanel>
            <Border BorderBrush="#CBD5E1" BorderThickness="1" Background="#FFFFFF" CornerRadius="4" Margin="0,8,0,0">
                <Canvas x:Name="cnvAnteprima" ClipToBounds="True" Background="#FFFFFF" Cursor="Hand"/>
            </Border>
        </DockPanel>

        <!-- dati -->
        <ScrollViewer Grid.Column="2" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Categoria" Style="{StaticResource Titolo}" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="rbFinestre" Content="Finestre" Margin="0,0,16,0" GroupName="cat"/>
                    <RadioButton x:Name="rbPorte" Content="Porte" GroupName="cat"/>
                </StackPanel>
                <TextBlock Text="Nome famiglia" Style="{StaticResource Titolo}"/>
                <TextBox x:Name="txtNome"/>
                <TextBlock Text="Dimensioni esterne telaio (mm)" Style="{StaticResource Titolo}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Larghezza" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtLarghezza" Grid.Column="1" Margin="0,0,0,4"/>
                    <TextBlock Text="Altezza" Grid.Row="1" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtAltezza" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"/>
                </Grid>
                <TextBlock Text="Misure delle zone (mm, dall'asse precedente)" Style="{StaticResource Titolo}"
                           TextWrapping="Wrap"/>
                <StackPanel x:Name="pnlMisure"/>
                <TextBlock Text="Profili (mm)" Style="{StaticResource Titolo}"/>
                <StackPanel x:Name="pnlProfili"/>
                <TextBlock Text="Cartella delle famiglie" Style="{StaticResource Titolo}"/>
                <DockPanel>
                    <Button x:Name="btnCartella" DockPanel.Dock="Right" Content="..." Margin="6,0,0,0" Padding="8,2"/>
                    <TextBox x:Name="txtCartella"/>
                </DockPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- in basso -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="btnAnnulla" Content="Annulla" Margin="0,0,6,0"/>
                <Button x:Name="btnCrea" Content="Crea famiglia e carica" Margin="0"
                        Background="#2563EB" Foreground="#FFFFFF" BorderBrush="#1D4ED8"/>
            </StackPanel>
            <TextBlock x:Name="txtErrori" Foreground="#DC2626" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
