<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="-"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Background="#F5F7FA">

    <StackPanel Margin="16">
        <Border Style="{StaticResource Intestazione}">
            <StackPanel>
                <TextBlock x:Name="lblTitolo" Text="-" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                <TextBlock x:Name="lblSottotitolo" Text="-" FontSize="12" Foreground="#DCE9F5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="txtSearch" ToolTip="Cerca"/>
            <Button Grid.Column="1" x:Name="btnTutte" Content="Seleziona tutte" Margin="8,0,0,0"/>
        </Grid>

        <Border Background="#FFFFFF" BorderBrush="#DDE3E8" BorderThickness="1" Margin="0,0,0,8">
            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="lstVoci">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#EEF2F5" BorderThickness="0,0,0,1" Padding="10,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Spuntata, Mode=TwoWay}" Margin="0" FontSize="13">
                                        <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis"/>
                                    </CheckBox>
                                    <TextBlock Grid.Column="1" Text="{Binding Dettaglio}" FontSize="11" Foreground="#5B6B78"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="lblVuoto" Style="{StaticResource Nota}" Visibility="Collapsed" Text="Nessuna voce corrisponde alla ricerca."/>
        <TextBlock x:Name="lblNota" Style="{StaticResource Nota}" Visibility="Collapsed" Text=""/>

        <Expander x:Name="expOpzioni" Header="Opzioni avanzate" IsExpanded="False">
            <Border Style="{StaticResource Scheda}" Margin="0,6,0,0">
                <StackPanel x:Name="pnlOpzioni"/>
            </Border>
        </Expander>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button x:Name="btnCancel" Content="Annulla" Width="90" Height="32" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="btnApply" Content="-" Height="32" Style="{StaticResource Primario}"/>
        </StackPanel>
    </StackPanel>
</Window>
