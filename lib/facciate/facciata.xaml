<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ritmo facciata"
        Height="740" Width="1160" MinHeight="580" MinWidth="900"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="12" Background="#F5F7FA">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- intestazione -->
        <Border Grid.ColumnSpan="2" Style="{StaticResource Intestazione}">
            <StackPanel>
                <TextBlock x:Name="lblTitolo" Text="Ritmo facciata" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                <TextBlock x:Name="lblSottotitolo" FontSize="12" Foreground="#DCE9F5" Margin="0,2,0,0"
                           Text="Un motivo di colonne e righe che si ripete, come in Archicad: moduli, classi di pannelli e montanti, tipi di Revit."/>
            </StackPanel>
        </Border>

        <!-- passi -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="btnPasso1" Content="1  Schema" Padding="14,6" Margin="0,0,6,0"/>
            <Button x:Name="btnPasso2" Content="2  Colonne" Padding="14,6" Margin="0,0,6,0"/>
            <Button x:Name="btnPasso3" Content="3  Righe" Padding="14,6" Margin="0,0,6,0"/>
            <Button x:Name="btnPasso4" Content="4  Classi" Padding="14,6" Margin="0,0,6,0"/>
            <Button x:Name="btnPasso5" Content="5  Tipi di Revit" Padding="14,6"/>
        </StackPanel>

        <!-- 1 schema -->
        <DockPanel x:Name="pnlPasso1" Grid.Row="2" Margin="0,0,12,0">
            <TextBlock DockPanel.Dock="Top" Text="PARTI DA UNO SCHEMA" Style="{StaticResource Etichetta}" Margin="0,0,0,4"/>
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button x:Name="btnSalvaSchema" Content="Salva schema"
                        ToolTip="Salva lo schema attuale (con le modifiche) tra i tuoi, con ★"/>
                <Button x:Name="btnEliminaSchema" Content="Elimina"
                        ToolTip="Si eliminano solo gli schemi salvati da te (quelli con ★)"/>
            </WrapPanel>
            <ListBox x:Name="lstSchemi"/>
        </DockPanel>

        <!-- 2 colonne -->
        <ScrollViewer x:Name="pnlPasso2" Grid.Row="2" Margin="0,0,12,0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Style="{StaticResource Nota}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Le colonne vanno da sinistra a destra, guardando la facciata da fuori. I moduli bloccati non cambiano misura."/>
                <Border Style="{StaticResource Scheda}">
                    <StackPanel x:Name="pnlColonne"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 3 righe -->
        <ScrollViewer x:Name="pnlPasso3" Grid.Row="2" Margin="0,0,12,0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Style="{StaticResource Nota}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Le righe vanno dal basso. Con i livelli il motivo ricomincia a ogni piano e sul livello c'è un traverso."/>
                <Border Style="{StaticResource Scheda}">
                    <StackPanel>
                        <CheckBox x:Name="chkLivelli" Content="Ricomincia a ogni livello"
                                  ToolTip="Traversi sui livelli del progetto che tagliano la facciata"/>
                        <Grid x:Name="grdLivelli" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Distanza dal livello (mm)" VerticalAlignment="Center"
                                       ToolTip="Positiva = traverso sopra il livello (es. sopra il solaio)"/>
                            <TextBox x:Name="txtOffsetLivelli" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Scheda}" Margin="0,8,0,0">
                    <StackPanel x:Name="pnlRighe"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 4 classi -->
        <ScrollViewer x:Name="pnlPasso4" Grid.Row="2" Margin="0,0,12,0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Style="{StaticResource Nota}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Clicca una cella o una linea nel disegno. Maiusc+clic aggiunge celle per unirle. La classe vale per lo stesso posto in ogni ripetizione del motivo."/>
                <Border Style="{StaticResource Scheda}">
                    <StackPanel>
                        <TextBlock x:Name="txtScelta" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8" Text="Niente di scelto"/>
                        <TextBlock Text="CLASSE" Style="{StaticResource Etichetta}" Margin="0,0,0,4"/>
                        <DockPanel>
                            <Button x:Name="btnAssegna" DockPanel.Dock="Right" Content="Assegna" Margin="6,0,0,0"
                                    ToolTip="Scrivi un nome nuovo per creare una classe"/>
                            <ComboBox x:Name="cmbClasse" IsEditable="True" IsTextSearchEnabled="False"/>
                        </DockPanel>
                        <StackPanel x:Name="pnlAmbito" Margin="0,8,0,0">
                            <TextBlock Text="VALE PER" Style="{StaticResource Etichetta}" Margin="0,0,0,4"/>
                            <RadioButton x:Name="rbCella" Content="Questa cella del motivo" GroupName="ambito" IsChecked="True"/>
                            <RadioButton x:Name="rbColonna" Content="Tutta la colonna" GroupName="ambito"/>
                            <RadioButton x:Name="rbRiga" Content="Tutta la riga" GroupName="ambito"/>
                        </StackPanel>
                        <TextBlock Text="CELLE UNITE" Style="{StaticResource Etichetta}" Margin="0,10,0,4"/>
                        <WrapPanel>
                            <Button x:Name="btnUnisci" Content="Unisci celle"
                                    ToolTip="Le celle scelte con Maiusc+clic diventano un pannello solo (stesso giro del motivo)"/>
                            <Button x:Name="btnSepara" Content="Separa"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 5 tipi -->
        <ScrollViewer x:Name="pnlPasso5" Grid.Row="2" Margin="0,0,12,0" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Style="{StaticResource Nota}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Per ogni classe il tipo di Revit. &quot;Tipo della facciata&quot; usa quello del tipo di curtain wall; i montanti di bordo restano quelli del tipo."/>
                <Border Style="{StaticResource Scheda}">
                    <StackPanel>
                        <TextBlock Text="PANNELLI" Style="{StaticResource Etichetta}" Margin="0,0,0,4"/>
                        <StackPanel x:Name="pnlTipiPannelli"/>
                        <TextBlock Text="MONTANTI E TRAVERSI" Style="{StaticResource Etichetta}" Margin="0,10,0,4"/>
                        <StackPanel x:Name="pnlTipiMontanti"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Scheda}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="NOME DELLO SCHEMA" Style="{StaticResource Etichetta}" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtNome"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- disegno -->
        <DockPanel Grid.Row="2" Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" x:Name="txtFacciata" Style="{StaticResource Nota}" Margin="0,0,0,6" TextWrapping="Wrap"/>
            <TextBlock DockPanel.Dock="Bottom" x:Name="txtAiuto" Style="{StaticResource Nota}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            <WrapPanel DockPanel.Dock="Bottom" x:Name="pnlLegenda" Margin="0,6,0,0"/>
            <Border Background="#FFFFFF" BorderBrush="#DDE3E8" BorderThickness="1" CornerRadius="6">
                <Canvas x:Name="cnvAnteprima" ClipToBounds="True" Background="#FFFFFF" Cursor="Hand"/>
            </Border>
        </DockPanel>

        <!-- piede -->
        <DockPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="btnAnnulla" Content="Annulla" Width="90" Height="32" Margin="0,0,16,0" IsCancel="True"/>
                <Button x:Name="btnIndietro" Content="&lt; Indietro" Width="90" Height="32" Margin="0,0,8,0"/>
                <Button x:Name="btnAvanti" Content="Avanti &gt;" Width="90" Height="32" Margin="0,0,8,0"/>
                <Button x:Name="btnApplica" Content="Applica alla facciata" Height="32" Style="{StaticResource Primario}"/>
            </StackPanel>
            <TextBlock x:Name="txtErrori" Foreground="#DC2626" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
