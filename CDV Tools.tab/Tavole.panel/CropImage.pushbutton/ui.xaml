<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ritaglia Immagine - CDV Tools"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#F8FAFC">
    <StackPanel Margin="16">
        <Border Background="#0F172A" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Ritaglia Immagine" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF"/>
                <TextBlock Text="Trascina per disegnare l'area da tenere, trascina i bordi per regolarla, trascina dentro per spostarla" FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <Border Background="#E2E8F0" Padding="8" CornerRadius="6" HorizontalAlignment="Center">
            <Grid>
                <Image x:Name="imgPreview" Stretch="Fill"/>
                <Canvas x:Name="cnv" Background="Transparent" Cursor="Cross" ClipToBounds="True">
                    <Rectangle x:Name="ombraSu" Fill="#99000000"/>
                    <Rectangle x:Name="ombraGiu" Fill="#99000000"/>
                    <Rectangle x:Name="ombraSx" Fill="#99000000"/>
                    <Rectangle x:Name="ombraDx" Fill="#99000000"/>
                    <Rectangle x:Name="selRect" Stroke="#FFFFFF" StrokeThickness="2" StrokeDashArray="4 2"/>
                </Canvas>
            </Grid>
        </Border>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="lblInfo" VerticalAlignment="Center" FontSize="12" Foreground="#475569" Margin="0,0,12,0"/>
            <Button Grid.Column="1" x:Name="btnReset" Content="Ripristina" ToolTip="Mostra di nuovo tutta l'immagine originale" Width="90" Height="32" Margin="0,0,8,0"/>
            <Button Grid.Column="2" x:Name="btnCancel" Content="Annulla" Width="90" Height="32" Margin="0,0,8,0"/>
            <Button Grid.Column="3" x:Name="btnApply" Content="Ritaglia" Width="110" Height="32" Background="#0F172A" Foreground="#FFFFFF" FontWeight="Bold"/>
        </Grid>
    </StackPanel>
</Window>
