<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ritaglia Immagine"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Background="#F5F7FA">
    <StackPanel Margin="16">
        <Border Style="{StaticResource Intestazione}">
            <StackPanel>
                <TextBlock Text="Ritaglia Immagine" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                <TextBlock Text="Trascina per disegnare l'area da tenere, trascina i bordi per regolarla, trascina dentro per spostarla" FontSize="12" Foreground="#DCE9F5" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <Border Background="#DDE3E8" Padding="8" CornerRadius="6" HorizontalAlignment="Center">
            <Grid>
                <Image x:Name="imgPreview" Stretch="Fill"/>
                <Canvas x:Name="cnv" Background="Transparent" Cursor="Cross" ClipToBounds="True">
                    <Rectangle x:Name="ombraSu" Fill="#99000000"/>
                    <Rectangle x:Name="ombraGiu" Fill="#99000000"/>
                    <Rectangle x:Name="ombraSx" Fill="#99000000"/>
                    <Rectangle x:Name="ombraDx" Fill="#99000000"/>
                    <Rectangle x:Name="selRect" Stroke="#FFFFFF" StrokeThickness="2" StrokeDashArray="4 2"/>
                </Canvas>
            </Grid>
        </Border>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="lblInfo" VerticalAlignment="Center" FontSize="12" Foreground="#4A5866" Margin="0,0,12,0"/>
            <Button Grid.Column="1" x:Name="btnReset" Content="Ripristina" ToolTip="Mostra di nuovo tutta l'immagine originale" Width="90" Height="32" Margin="0,0,8,0"/>
            <Button Grid.Column="2" x:Name="btnCancel" Content="Annulla" Width="90" Height="32" Margin="0,0,8,0" IsCancel="True"/>
            <Button Grid.Column="3" x:Name="btnApply" Content="Ritaglia" Width="110" Height="32" Style="{StaticResource Primario}" IsDefault="True"/>
        </Grid>
    </StackPanel>
</Window>
