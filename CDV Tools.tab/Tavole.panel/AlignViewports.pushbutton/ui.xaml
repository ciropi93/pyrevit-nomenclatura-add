<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Allinea Viste su Tavole"
        Height="730" Width="820"
        MinHeight="550" MinWidth="700"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Background="#F5F7FA">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Source Card -->
            <RowDefinition Height="Auto"/> <!-- Search & Filters -->
            <RowDefinition Height="*"/>    <!-- Target Viewports List -->
            <RowDefinition Height="Auto"/> <!-- Options -->
            <RowDefinition Height="Auto"/> <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource Intestazione}">
            <StackPanel>
                <TextBlock Text="Allinea Viste su Tavole" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                <TextBlock Text="Allinea la posizione e il titolo di una vista su altre tavole del progetto affinché coincidano perfettamente" FontSize="12" Foreground="#DCE9F5" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Source Viewport Card -->
        <Border Grid.Row="1" Padding="14" Margin="0,0,0,10" Style="{StaticResource Scheda}">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="VISTA SORGENTE:" VerticalAlignment="Center" Margin="0,0,12,0" Style="{StaticResource Etichetta}"/>
                    <ComboBox Grid.Column="1" x:Name="cmbSourceViewport" Height="28" VerticalContentAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                </Grid>

                <!-- Source Status Badges -->
                <WrapPanel Margin="0,4,0,0">
                    <Border Background="#E8F1FA" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <TextBlock x:Name="lblSourceSheet" Text="Tavola: -" FontSize="11" FontWeight="SemiBold" Foreground="#185A91"/>
                    </Border>
                    <Border Background="#EEF2F5" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <TextBlock x:Name="lblSourceViewType" Text="Tipo: -" FontSize="11" FontWeight="SemiBold" Foreground="#4A5866"/>
                    </Border>
                    <Border Background="#EEF2F5" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <TextBlock x:Name="lblSourceScale" Text="Scala: -" FontSize="11" Foreground="#4A5866"/>
                    </Border>
                    <Border Background="#EEF2F5" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <TextBlock x:Name="lblSourcePos" Text="Centro: -" FontSize="11" Foreground="#5B6B78"/>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Search & Filters -->
        <Border Grid.Row="2" Padding="10" Margin="0,0,0,8" Style="{StaticResource Scheda}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="txtSearch" Height="28" VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,8,0" FontSize="12" ToolTip="Cerca per numero tavola, nome tavola o nome vista..."/>
                    <ComboBox Grid.Column="1" x:Name="cmbViewTypeFilter" Height="28" VerticalContentAlignment="Center" FontSize="12"/>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="btnSelectAll" Content="Seleziona Tutte" Padding="8,4"/>
                    <Button x:Name="btnDeselectAll" Content="Deseleziona Tutte" Padding="8,4"/>
                    <Button x:Name="btnSelectSameType" Content="Stesso Tipo Vista" Padding="8,4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Target Viewports List -->
        <Border Grid.Row="3" Padding="4" Margin="0,0,0,8" Style="{StaticResource Scheda}">
            <ListView x:Name="lstTargetViewports" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="45">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Tavola" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SheetDisplay}" FontWeight="SemiBold" FontSize="12" Foreground="#2B3640" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Vista Collocata" Width="220">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ViewName}" FontWeight="SemiBold" FontSize="12" Foreground="#185A91" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Tipo" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ViewTypeName}" FontSize="11" Foreground="#4A5866" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Scala" Width="70">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ScaleStr}" FontSize="11" Foreground="#5B6B78" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Posizione Attuale" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PositionStr}" FontSize="10" Foreground="#8C9AA6" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Options Card -->
        <Border Grid.Row="4" Padding="12,10" Margin="0,0,0,10" Style="{StaticResource Scheda}">
            <StackPanel>
                <!-- Metodo di allineamento -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Metodo di Allineamento:" VerticalAlignment="Center" Margin="0,0,12,0" Style="{StaticResource Etichetta}"/>
                    <RadioButton x:Name="rbAlignModel" Content="Coordinate del Modello (consigliato: fabbricato/griglie coincidenti)" IsChecked="True"/>
                    <RadioButton x:Name="rbAlignBoxCenter" Content="Centro Riquadro Vista (Box Center)"/>
                </StackPanel>

                <!-- Opzioni Titolo -->
                <WrapPanel>
                    <CheckBox x:Name="chkAlignTitle" Content="Allinea posizione titolo vista (Label Offset)" IsChecked="True" Margin="0,0,16,0"/>
                    <CheckBox x:Name="chkAlignTitleLength" Content="Allinea lunghezza riga titolo" IsChecked="True" Margin="0,0,16,0"/>
                    <CheckBox x:Name="chkApplyType" Content="Applica stesso stile/tipo Viewport" IsChecked="True"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Footer Actions -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="lblSelectionSummary" Text="0 viste selezionate" VerticalAlignment="Center" FontSize="12" Foreground="#5B6B78" FontWeight="Medium"/>
            <Button Grid.Column="1" x:Name="btnCancel" Content="Annulla" Width="90" Height="32" Margin="0,0,8,0" IsCancel="True"/>
            <Button Grid.Column="2" x:Name="btnApply" Content="Allinea Viste" Width="140" Height="32" Style="{StaticResource Primario}"/>
        </Grid>
    </Grid>
</Window>
