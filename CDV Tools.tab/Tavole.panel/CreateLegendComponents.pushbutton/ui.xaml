<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inserisci Componenti in Legenda - CDV Tools"
        Height="740" Width="820"
        MinHeight="550" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#F8FAFC">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,16,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Legend Choice Card -->
            <RowDefinition Height="Auto"/> <!-- Action / Filter bar for components -->
            <RowDefinition Height="*"/>    <!-- Selected Elements/Types List -->
            <RowDefinition Height="Auto"/> <!-- Layout & Appearance Settings -->
            <RowDefinition Height="Auto"/> <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Inserisci Componenti in Legenda" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF"/>
                <TextBlock Text="Inserisce in modo ordinato i Componenti Legenda e le descrizioni per gli elementi o tipi selezionati" FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Legend Choice Card -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="LEGENDA DI DESTINAZIONE:" FontWeight="Bold" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox Grid.Column="1" x:Name="cmbTargetLegend" Height="28" VerticalContentAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                    <Button Grid.Column="2" x:Name="btnDuplicateLegend" Content="+ Duplica Legenda" Margin="8,0,0,0" Padding="10,4" ToolTip="Crea una copia della legenda selezionata"/>
                </Grid>

                <!-- Status Badges -->
                <WrapPanel Margin="0,8,0,0">
                    <Border Background="#E0F2FE" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <TextBlock x:Name="lblLegendScale" Text="Scala Legenda: -" FontSize="11" FontWeight="SemiBold" Foreground="#0369A1"/>
                    </Border>
                    <Border Background="#F1F5F9" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <TextBlock x:Name="lblLegendElementsCount" Text="Elementi già presenti: -" FontSize="11" Foreground="#475569"/>
                    </Border>
                    <Border x:Name="bdrTemplateStatus" Background="#FEF3C7" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <TextBlock x:Name="lblTemplateStatus" Text="Verifica componente campione..." FontSize="11" FontWeight="SemiBold" Foreground="#B45309"/>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Selection Toolbar -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TIPI RILEVATI DAGLI ELEMENTI SELEZIONATI" FontWeight="Bold" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="lblTypesCount" Text="(0 tipi unici)" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btnSelectAll" Content="Seleziona Tutti" Padding="8,4"/>
                    <Button x:Name="btnDeselectAll" Content="Deseleziona Tutti" Padding="8,4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Types List -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,0,8">
            <ListView x:Name="lstComponentTypes" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="45">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Categoria" Width="140">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CategoryName}" FontWeight="SemiBold" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Nome Famiglia" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FamilyName}" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Nome del Tipo" Width="240">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TypeName}" FontWeight="SemiBold" FontSize="12" Foreground="#0369A1" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Istanze" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding InstanceCountStr}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Layout & Appearance Options Card -->
        <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: Layout Direction, Spacing and View Direction -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Disposizione:" FontWeight="Bold" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <RadioButton x:Name="rbVertical" Content="In Colonna" IsChecked="True"/>
                        <RadioButton x:Name="rbHorizontal" Content="In Riga"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Spaziatura:" FontWeight="Bold" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="txtSpacing" Width="65" Height="26" VerticalContentAlignment="Center" Text="1500 mm" FontSize="11"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Vista Componente:" FontWeight="Bold" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="cmbViewDirection" Width="140" Height="26" VerticalContentAlignment="Center" FontSize="11"/>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Text Description Options -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" x:Name="chkAddTextNote" Content="Aggiungi descrizione testuale" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Stile Testo:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="cmbTextType" Width="140" Height="26" VerticalContentAlignment="Center" FontSize="11"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Formato:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="cmbTextFormat" Width="130" Height="26" VerticalContentAlignment="Center" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Footer Actions -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="lblSelectionSummary" Text="0 tipi selezionati" VerticalAlignment="Center" FontSize="12" Foreground="#64748B" FontWeight="Medium"/>
            <Button Grid.Column="1" x:Name="btnCancel" Content="Annulla" Width="90" Height="32" Margin="0,0,8,0"/>
            <Button Grid.Column="2" x:Name="btnApply" Content="Inserisci in Legenda" Width="160" Height="32" Background="#0F172A" Foreground="#FFFFFF" FontWeight="Bold"/>
        </Grid>
    </Grid>
</Window>
