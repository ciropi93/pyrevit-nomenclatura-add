<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Componenti in legenda"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Background="#F5F7FA">

    <StackPanel Margin="16">
        <Border Style="{StaticResource Intestazione}">
            <StackPanel>
                <TextBlock Text="Componenti in legenda" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                <TextBlock x:Name="lblTipi" Text="-" FontSize="12" Foreground="#DCE9F5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <TextBlock Text="IN QUALE LEGENDA?" Style="{StaticResource Etichetta}" Margin="0,0,0,4"/>
        <ListBox x:Name="lstLegende" MaxHeight="260" Margin="0,0,0,8">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding Dettaglio}" FontSize="11" FontWeight="Normal"
                                   Foreground="#5B6B78" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="lblRiepilogo" Style="{StaticResource Nota}" Text=""/>

        <Expander x:Name="expOpzioni" Header="Opzioni avanzate" IsExpanded="False">
            <Border Style="{StaticResource Scheda}" Margin="0,6,0,0">
                <StackPanel>
                    <WrapPanel>
                        <RadioButton x:Name="rbVertical" GroupName="Disp" IsChecked="True" Content="In colonna" Margin="0,0,16,0"/>
                        <RadioButton x:Name="rbHorizontal" GroupName="Disp" Content="In riga"/>
                    </WrapPanel>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Ogni" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="txtSpacing" Text="1500 mm" ToolTip="Distanza tra un componente e l'altro (mm, cm o m)"/>
                        <TextBlock Grid.Row="1" Text="Vista del componente" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cmbViewDirection" Margin="0,6,0,0"/>
                    </Grid>
                    <CheckBox x:Name="chkAddTextNote" IsChecked="True" Content="Scrivi il nome accanto" Margin="0,10,0,0"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="cmbTextFormat" Margin="0,0,4,0"/>
                        <ComboBox Grid.Column="1" x:Name="cmbTextType" Margin="4,0,0,0" ToolTip="Stile del testo"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Expander>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button x:Name="btnCancel" Content="Annulla" Width="90" Height="32" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="btnApply" Content="Inserisci" Height="32" Style="{StaticResource Primario}" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
