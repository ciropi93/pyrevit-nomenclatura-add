<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inserisci Componenti in Legenda"
        Height="740" Width="820"
        MinHeight="550" MinWidth="680"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Background="#F5F7FA">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Legend Choice Card -->
            <RowDefinition Height="Auto"/> <!-- Action / Filter bar for components -->
            <RowDefinition Height="*"/>    <!-- Selected Elements/Types List -->
            <RowDefinition Height="Auto"/> <!-- Layout & Appearance Settings -->
            <RowDefinition Height="Auto"/> <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource Intestazione}">
            <StackPanel>
                <TextBlock Text="Inserisci Componenti in Legenda" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                <TextBlock Text="Inserisce in modo ordinato i Componenti Legenda e le descrizioni per gli elementi o tipi selezionati" FontSize="12" Foreground="#DCE9F5" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Legend Choice Card -->
        <Border Grid.Row="1" Padding="14" Margin="0,0,0,10" Style="{StaticResource Scheda}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="LEGENDA DI DESTINAZIONE:" VerticalAlignment="Center" Margin="0,0,12,0" Style="{StaticResource Etichetta}"/>
                    <ComboBox Grid.Column="1" x:Name="cmbTargetLegend" Height="28" VerticalContentAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                    <Button Grid.Column="2" x:Name="btnDuplicateLegend" Content="+ Duplica Legenda" Margin="8,0,0,0" Padding="10,4" ToolTip="Crea una copia della legenda selezionata"/>
                </Grid>

                <!-- Status Badges -->
                <WrapPanel Margin="0,8,0,0">
                    <Border Background="#E8F1FA" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <TextBlock x:Name="lblLegendScale" Text="Scala Legenda: -" FontSize="11" FontWeight="SemiBold" Foreground="#185A91"/>
                    </Border>
                    <Border Background="#EEF2F5" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <TextBlock x:Name="lblLegendElementsCount" Text="Elementi già presenti: -" FontSize="11" Foreground="#4A5866"/>
                    </Border>
                    <Border x:Name="bdrTemplateStatus" Background="#FEF3C7" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <TextBlock x:Name="lblTemplateStatus" Text="Verifica componente campione..." FontSize="11" FontWeight="SemiBold" Foreground="#B45309"/>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Selection Toolbar -->
        <Border Grid.Row="2" Padding="10" Margin="0,0,0,8" Style="{StaticResource Scheda}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TIPI RILEVATI DAGLI ELEMENTI SELEZIONATI" VerticalAlignment="Center" Margin="0,0,12,0" Style="{StaticResource Etichetta}"/>
                    <TextBlock x:Name="lblTypesCount" Text="(0 tipi unici)" FontSize="11" Foreground="#8C9AA6" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btnSelectAll" Content="Seleziona Tutti" Padding="8,4"/>
                    <Button x:Name="btnDeselectAll" Content="Deseleziona Tutti" Padding="8,4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Types List -->
        <Border Grid.Row="3" Padding="4" Margin="0,0,0,8" Style="{StaticResource Scheda}">
            <ListView x:Name="lstComponentTypes" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="45">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Categoria" Width="140">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CategoryName}" FontWeight="SemiBold" FontSize="11" Foreground="#4A5866" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Nome Famiglia" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FamilyName}" FontSize="12" Foreground="#2B3640" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Nome del Tipo" Width="240">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TypeName}" FontWeight="SemiBold" FontSize="12" Foreground="#185A91" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Istanze" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding InstanceCountStr}" FontSize="11" Foreground="#5B6B78" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Layout & Appearance Options Card -->
        <Border Grid.Row="4" Padding="12,10" Margin="0,0,0,10" Style="{StaticResource Scheda}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: Layout Direction, Spacing and View Direction -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Disposizione:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Etichetta}"/>
                        <RadioButton x:Name="rbVertical" Content="In Colonna" IsChecked="True"/>
                        <RadioButton x:Name="rbHorizontal" Content="In Riga"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Spaziatura:" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Etichetta}"/>
                        <TextBox x:Name="txtSpacing" Width="65" Height="26" VerticalContentAlignment="Center" Text="1500 mm" FontSize="11"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Vista Componente:" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Etichetta}"/>
                        <ComboBox x:Name="cmbViewDirection" Width="140" Height="26" VerticalContentAlignment="Center" FontSize="11"/>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Text Description Options -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" x:Name="chkAddTextNote" Content="Aggiungi descrizione testuale" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Stile Testo:" FontSize="11" Foreground="#5B6B78" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="cmbTextType" Width="140" Height="26" VerticalContentAlignment="Center" FontSize="11"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Formato:" FontSize="11" Foreground="#5B6B78" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="cmbTextFormat" Width="130" Height="26" VerticalContentAlignment="Center" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Footer Actions -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="lblSelectionSummary" Text="0 tipi selezionati" VerticalAlignment="Center" FontSize="12" Foreground="#5B6B78" FontWeight="Medium"/>
            <Button Grid.Column="1" x:Name="btnCancel" Content="Annulla" Width="90" Height="32" Margin="0,0,8,0" IsCancel="True"/>
            <Button Grid.Column="2" x:Name="btnApply" Content="Inserisci in Legenda" Width="160" Height="32" Style="{StaticResource Primario}" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
