<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aggiorna Modello di Vista da Vista - CDV Tools"
        Height="680" Width="760"
        MinHeight="520" MinWidth="650"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#F8FAFC">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,16,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Source View Card -->
            <RowDefinition Height="*"/>    <!-- Target Template Card -->
            <RowDefinition Height="Auto"/> <!-- Options Card -->
            <RowDefinition Height="Auto"/> <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Aggiorna Modello di Vista da Vista" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF"/>
                <TextBlock Text="Trasferisce le modifiche e le impostazioni grafiche della vista corrente al modello di vista desiderato" FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Source View Card -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="VISTA SORGENTE:" FontWeight="Bold" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox Grid.Column="1" x:Name="cmbSourceView" Height="28" VerticalContentAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                </Grid>

                <!-- Source Status Badges -->
                <WrapPanel Margin="0,4,0,0">
                    <Border Background="#E0F2FE" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <TextBlock x:Name="lblSourceType" Text="Tipo: -" FontSize="11" FontWeight="SemiBold" Foreground="#0369A1"/>
                    </Border>
                    <Border x:Name="bdrSourceTemplate" Background="#FEF3C7" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <TextBlock x:Name="lblSourceTemplate" Text="Modello: Nessuno (Sganciato)" FontSize="11" FontWeight="SemiBold" Foreground="#B45309"/>
                    </Border>
                    <Border Background="#F1F5F9" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <TextBlock x:Name="lblSourceOverrides" Text="Sovrascritture: -" FontSize="11" Foreground="#475569"/>
                    </Border>
                    <Border Background="#F1F5F9" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <TextBlock x:Name="lblSourceFilters" Text="Filtri: -" FontSize="11" Foreground="#475569"/>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Target Template Card -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Mode Selection -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="AZIONE:" FontWeight="Bold" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <RadioButton x:Name="rbUpdateExisting" Content="Aggiorna Modello Esistente" IsChecked="True"/>
                    <RadioButton x:Name="rbCreateNew" Content="Crea Nuovo Modello da questa Vista"/>
                </StackPanel>

                <!-- Existing Template Panel -->
                <StackPanel Grid.Row="1" x:Name="pnlUpdateExisting">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="txtSearchTemplate" Height="28" VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,8,0" FontSize="12" ToolTip="Cerca modello per nome..."/>
                        <ComboBox Grid.Column="1" x:Name="cmbTypeFilter" Height="28" VerticalContentAlignment="Center" FontSize="12"/>
                    </Grid>

                    <TextBlock Text="MODELLO DI VISTA DA AGGIORNARE:" FontWeight="Bold" FontSize="11" Foreground="#64748B" Margin="0,4,0,4"/>
                    <ComboBox x:Name="cmbTargetTemplate" Height="30" VerticalContentAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Create New Template Panel -->
                <StackPanel Grid.Row="1" x:Name="pnlCreateNew" Visibility="Collapsed">
                    <TextBlock Text="NOME DEL NUOVO MODELLO DI VISTA:" FontWeight="Bold" FontSize="11" Foreground="#64748B" Margin="0,4,0,4"/>
                    <TextBox x:Name="txtNewTemplateName" Height="30" VerticalContentAlignment="Center" Padding="8,0" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Template Details & Usage Warning -->
                <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="IMPATTO SUL MODELLO:" FontWeight="Bold" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBlock x:Name="lblTemplateUsage" Text="Seleziona un modello di vista..." FontSize="12" Foreground="#0F172A" TextWrapping="Wrap"/>
                        <TextBlock x:Name="lblTemplateWarning" Text="Tutte le viste del progetto che utilizzano questo modello erediteranno all'istante le nuove impostazioni." FontSize="11" Foreground="#0369A1" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Options Card -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
            <StackPanel>
                <CheckBox x:Name="chkReassign" Content="Riassegna questo Modello di Vista alla vista corrente (riaggancia la vista al termine)" IsChecked="True" FontWeight="SemiBold" Foreground="#0369A1"/>
            </StackPanel>
        </Border>

        <!-- Footer Actions -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="lblSummary" Text="Pronto per l'aggiornamento" VerticalAlignment="Center" FontSize="12" Foreground="#64748B"/>
            <Button Grid.Column="1" x:Name="btnCancel" Content="Annulla" Width="90" Height="32" Margin="0,0,8,0"/>
            <Button Grid.Column="2" x:Name="btnApply" Content="Aggiorna Modello" Width="150" Height="32" Background="#0F172A" Foreground="#FFFFFF" FontWeight="Bold"/>
        </Grid>
    </Grid>
</Window>
