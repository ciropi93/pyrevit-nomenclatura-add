<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Campitura da Polilinea"
        Width="580" SizeToContent="Height" MinWidth="520"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Background="#F5F7FA">

    <StackPanel Margin="16">
        <!-- Intestazione -->
        <Border Style="{StaticResource Intestazione}">
            <StackPanel>
                <TextBlock Text="Campitura da Polilinea" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                <TextBlock Text="Campitura a distanza fissa dalle linee selezionate" FontSize="12" Foreground="#DCE9F5" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Linee -->
        <Border Style="{StaticResource Scheda}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="LINEE" Style="{StaticResource Etichetta}" Margin="0,0,0,3"/>
                    <TextBlock x:Name="lblSelectionInfo" Text="Linee rilevate: 0 elementi" FontWeight="SemiBold" FontSize="13" Foreground="#2B3640"/>
                    <TextBlock x:Name="lblSelectionDetail" Text="Linee di dettaglio o di modello" FontSize="11" Foreground="#5B6B78" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="btnReselect" Content="Seleziona..." VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Distanza, lato e tipo -->
        <Border Style="{StaticResource Scheda}">
            <StackPanel>
                <TextBlock Text="DISTANZA" Style="{StaticResource Etichetta}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtOffset" Grid.Column="0" Height="32" FontSize="14" FontWeight="SemiBold" Text="150 cm"
                             ToolTip="Scrivi con l'unità: 1500mm, 150cm, 1.50m (senza unità vale in mm)"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button x:Name="btnPreset500mm" Content="50 cm" Padding="8,4" FontSize="11"/>
                        <Button x:Name="btnPreset100cm" Content="100 cm" Padding="8,4" FontSize="11"/>
                        <Button x:Name="btnPreset150cm" Content="150 cm" Padding="8,4" FontSize="11"/>
                        <Button x:Name="btnPreset200cm" Content="200 cm" Padding="8,4" FontSize="11"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="LATO" Style="{StaticResource Etichetta}" Margin="0,12,0,4"/>
                <WrapPanel>
                    <RadioButton x:Name="rbBoth" GroupName="OffsetSide" IsChecked="True" Content="Entrambi i lati (centrata)" Margin="0,0,16,0"
                                 ToolTip="La distanza è lo spessore totale: 150 cm = 75 cm per lato"/>
                    <RadioButton x:Name="rbLeft" GroupName="OffsetSide" Content="Solo a sinistra" Margin="0,0,16,0"
                                 ToolTip="Rispetto al verso in cui è disegnata la polilinea"/>
                    <RadioButton x:Name="rbRight" GroupName="OffsetSide" Content="Solo a destra"
                                 ToolTip="Rispetto al verso in cui è disegnata la polilinea"/>
                </WrapPanel>

                <TextBlock Text="TIPO DI CAMPITURA" Style="{StaticResource Etichetta}" Margin="0,12,0,4"/>
                <ComboBox x:Name="cmbFilledRegionType" DisplayMemberPath="Name"/>
            </StackPanel>
        </Border>

        <!-- Opzioni avanzate -->
        <Expander Header="Opzioni avanzate" IsExpanded="False">
            <Border Style="{StaticResource Scheda}" Margin="0,6,0,0">
                <StackPanel>
                    <TextBlock Text="STILE LINEA DEI BORDI" Style="{StaticResource Etichetta}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cmbLineStyle" DisplayMemberPath="Name" Margin="0,0,0,10"/>
                    <CheckBox x:Name="chkClosedDonut" Content="Per linee chiuse: crea un nastro (anello interno ed esterno)" IsChecked="True"/>
                    <TextBlock Text="LINEE ORIGINALI" Style="{StaticResource Etichetta}" Margin="0,10,0,2"/>
                    <WrapPanel>
                        <RadioButton x:Name="rbKeepLines" GroupName="LineAction" IsChecked="True" Content="Conserva" Margin="0,0,16,0"/>
                        <RadioButton x:Name="rbDeleteLines" GroupName="LineAction" Content="Elimina (resta solo la campitura)"/>
                    </WrapPanel>
                    <CheckBox x:Name="chkSelectResult" Content="Seleziona la campitura creata" IsChecked="True" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Expander>

        <!-- Piede -->
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="lblStatus" Grid.Column="0" Text="Pronto" VerticalAlignment="Center" Foreground="#5B6B78" FontSize="12" TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="btnCancel" Content="Annulla" Width="90" Height="32" Margin="0,0,8,0" IsCancel="True"/>
                <Button x:Name="btnApply" Content="Crea campitura" Height="32" Style="{StaticResource Primario}" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
