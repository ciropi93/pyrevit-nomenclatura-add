<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Campitura da Polilinea | CDV Tools"
        Height="760" Width="660"
        MinHeight="680" MinWidth="580"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#F8FAFC">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Campitura da Polilinea / Offset" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF"/>
                    <TextBlock Text="Genera una campitura continua con offset da linee o catene selezionate" FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#0284C7" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock Text="CDV Tools" FontWeight="SemiBold" FontSize="11" Foreground="#FFFFFF"/>
                </Border>
            </Grid>
        </Border>

        <!-- 1. Selection Card -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="ELEMENTI DI ORIGINE" FontWeight="Bold" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBlock x:Name="lblSelectionInfo" Text="Linee rilevate: 0 elementi" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A"/>
                    <TextBlock x:Name="lblSelectionDetail" Text="Tipo: Linee di dettaglio / modello" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="btnReselect" Content="Seleziona nel Modello..." VerticalAlignment="Center" Padding="10,5"/>
            </Grid>
        </Border>

        <!-- 2. Offset Distance Card -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="VALORE DI OFFSET / SPESSORE" FontWeight="Bold" FontSize="11" Foreground="#64748B" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtOffset" Grid.Column="0" Height="34" VerticalContentAlignment="Center" Padding="10,0" FontSize="14" FontWeight="SemiBold" Text="150 cm" BorderBrush="#CBD5E1"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button x:Name="btnPreset500mm" Content="500 mm" Padding="8,4" FontSize="11"/>
                        <Button x:Name="btnPreset100cm" Content="100 cm" Padding="8,4" FontSize="11"/>
                        <Button x:Name="btnPreset150cm" Content="150 cm" Padding="8,4" FontSize="11"/>
                        <Button x:Name="btnPreset200cm" Content="200 cm" Padding="8,4" FontSize="11"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="💡 Puoi digitare liberamente con unità: es. 1500mm, 150cm, 1.50m (senza unità interpreta come mm)." FontSize="11" Foreground="#64748B"/>
            </StackPanel>
        </Border>

        <!-- 3. Offset Side / Mode Card -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="LATO DI APPLICAZIONE OFFSET" FontWeight="Bold" FontSize="11" Foreground="#64748B" Margin="0,0,0,8"/>
                <StackPanel Margin="4,0,0,0">
                    <RadioButton x:Name="rbBoth" GroupName="OffsetSide" IsChecked="True" Margin="0,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↔️ Entrambi i Lati " FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock Text="(Spessore totale centrato: es. 150cm = 75cm a sx + 75cm a dx)" Foreground="#64748B"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="rbLeft" GroupName="OffsetSide" Margin="0,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⬅️ Solo Lato Sinistro " FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock Text="(Rispetto al verso di percorrenza della polilinea)" Foreground="#64748B"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="rbRight" GroupName="OffsetSide" Margin="0,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➡️ Solo Lato Destro " FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock Text="(Rispetto al verso di percorrenza della polilinea)" Foreground="#64748B"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                <Border Background="#F1F5F9" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
                    <CheckBox x:Name="chkClosedDonut" Content="Per anelli chiusi: crea nastro perimetrale cavo (doppio anello interno/esterno)" IsChecked="True"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- 4. Filled Region Properties Card -->
        <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Filled Region Type -->
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="TIPO DI CAMPITURA" FontWeight="Bold" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cmbFilledRegionType" DisplayMemberPath="Name" Height="30" VerticalContentAlignment="Center" FontSize="12"/>
                </StackPanel>

                <!-- Boundary Line Style -->
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="STILE LINEA BORDI" FontWeight="Bold" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cmbLineStyle" DisplayMemberPath="Name" Height="30" VerticalContentAlignment="Center" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 5. Original Lines Action Card (Conserva vs Elimina) -->
        <Border Grid.Row="5" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="GESTIONE LINEE GUIDA ORIGINALI" FontWeight="Bold" FontSize="11" Foreground="#64748B" Margin="0,0,0,8"/>
                <StackPanel Margin="4,0,0,0">
                    <RadioButton x:Name="rbKeepLines" GroupName="LineAction" IsChecked="True" Margin="0,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🟢 Conserva le linee originali " FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock Text="(Le linee di dettaglio/modello rimarranno nel disegno)" Foreground="#64748B"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="rbDeleteLines" GroupName="LineAction" Margin="0,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔴 Elimina le linee originali " FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock Text="(Rimuove le linee di origine lasciando solo la nuova campitura)" Foreground="#64748B"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                <CheckBox x:Name="chkSelectResult" Content="Seleziona la nuova campitura creata al termine" IsChecked="True" Margin="4,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Spacer row -->
        <Grid Grid.Row="6"/>

        <!-- Footer -->
        <Grid Grid.Row="7" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="lblStatus" Grid.Column="0" Text="Pronto" VerticalAlignment="Center" Foreground="#64748B" FontSize="12" FontWeight="Medium" TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="btnCancel" Content="Annulla" Width="90" Height="36" Margin="0,0,8,0" IsCancel="True"/>
                <Button x:Name="btnApply" Content="Crea Campitura" Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Height="36" Padding="18,0" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
