<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Campitura per Sezione"
        Width="720" SizeToContent="Height" MinWidth="660"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Background="#F5F7FA">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource Intestazione}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Campitura per Sezione" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                    <TextBlock Text="Campitura (es. terreno) dal bordo degli elementi sezionati" FontSize="12" Foreground="#DCE9F5" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. Selection & Crop Card -->
        <Border Grid.Row="1" Padding="12" Margin="0,0,0,8" Style="{StaticResource Scheda}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="1. ELEMENTI SEZIONATI DI ORIGINE" Margin="0,0,0,3" Style="{StaticResource Etichetta}"/>
                        <TextBlock x:Name="lblSelectionInfo" Text="0 elementi selezionati" FontWeight="SemiBold" FontSize="13" Foreground="#2B3640"/>
                        <TextBlock x:Name="lblSelectionDetail" Text="Seleziona uno o piu pavimenti/elementi tagliati dalla sezione" FontSize="11" Foreground="#5B6B78" Margin="0,1,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="btnReselect" Content="Seleziona..." VerticalAlignment="Center" Padding="10,6" Margin="4,0"/>
                    <Button Grid.Column="2" x:Name="btnSelectLink" Content="+ Da Link RVT..." VerticalAlignment="Center" Padding="10,6"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 2. Bordo Sezionato (Superiore vs Inferiore) con Icone Illustrative -->
        <Border Grid.Row="2" Padding="12" Margin="0,0,0,8" Style="{StaticResource Scheda}">
            <StackPanel>
                <TextBlock Text="2. PROFILO SEZIONATO DA SEGUIRE E DIREZIONE" Margin="0,0,0,6" Style="{StaticResource Etichetta}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card Bordo Inferiore -->
                    <Border Grid.Column="0" Background="#F5F7FA" BorderBrush="#C9D3DB" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,6,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="68"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Icona Bordo Inferiore -->
                            <Border Grid.Column="0" Width="62" Height="46" HorizontalAlignment="Left" Style="{StaticResource Scheda}" Padding="0" Margin="0">
                                <Canvas Width="62" Height="46">
                                    <!-- Retino terreno sotto -->
                                    <Polygon Points="6,24 56,16 56,40 6,40" Fill="#DCFCE7"/>
                                    <!-- Solaio inclinato -->
                                    <Polygon Points="6,14 56,6 56,16 6,24" Fill="#C9D3DB" Stroke="#5B6B78" StrokeThickness="1"/>
                                    <!-- Linea Bordo Inferiore Evidenziata -->
                                    <Line X1="6" Y1="24" X2="56" Y2="16" Stroke="#DC2626" StrokeThickness="2.8"/>
                                </Canvas>
                            </Border>
                            <RadioButton Grid.Column="1" x:Name="rbEdgeBottom" GroupName="CutEdge" IsChecked="True" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Bordo Inferiore" FontWeight="Bold" Foreground="#2B3640"/>
                                    <TextBlock Text="Intradosso solaio (terreno sotto il pavimento)" FontSize="10.5" Foreground="#5B6B78" TextWrapping="Wrap"/>
                                </StackPanel>
                            </RadioButton>
                        </Grid>
                    </Border>

                    <!-- Card Bordo Superiore -->
                    <Border Grid.Column="1" Background="#F5F7FA" BorderBrush="#C9D3DB" BorderThickness="1" CornerRadius="6" Padding="8" Margin="6,0,6,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="68"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Icona Bordo Superiore -->
                            <Border Grid.Column="0" Width="62" Height="46" HorizontalAlignment="Left" Style="{StaticResource Scheda}" Padding="0" Margin="0">
                                <Canvas Width="62" Height="46">
                                    <!-- Retino terreno da estradosso -->
                                    <Polygon Points="6,14 56,6 56,40 6,40" Fill="#DCFCE7"/>
                                    <!-- Solaio inclinato tratteggiato -->
                                    <Polygon Points="6,14 56,6 56,16 6,24" Fill="#DDE3E8" Stroke="#8C9AA6" StrokeThickness="1"/>
                                    <!-- Linea Bordo Superiore Evidenziata -->
                                    <Line X1="6" Y1="14" X2="56" Y2="6" Stroke="#1F6FB2" StrokeThickness="2.8"/>
                                </Canvas>
                            </Border>
                            <RadioButton Grid.Column="1" x:Name="rbEdgeTop" GroupName="CutEdge" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Bordo Superiore" FontWeight="Bold" Foreground="#2B3640"/>
                                    <TextBlock Text="Estradosso / filo superiore del pavimento" FontSize="10.5" Foreground="#5B6B78" TextWrapping="Wrap"/>
                                </StackPanel>
                            </RadioButton>
                        </Grid>
                    </Border>

                    <!-- Direzione sviluppo (Sotto vs Sopra) -->
                    <Border Grid.Column="2" Background="#EEF2F5" BorderBrush="#C9D3DB" BorderThickness="1" CornerRadius="6" Padding="10,6">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SVILUPPO" FontWeight="Bold" FontSize="10" Foreground="#5B6B78" Margin="0,0,0,2"/>
                            <RadioButton x:Name="rbDirDown" GroupName="FillDir" Content="Verso il Basso" IsChecked="True" FontSize="11.5" FontWeight="SemiBold"/>
                            <RadioButton x:Name="rbDirUp" GroupName="FillDir" Content="Verso l'Alto" FontSize="11.5"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3. Modalita di Chiusura del Fondo (3 Card con Icone Illustrative) -->
        <Border Grid.Row="3" Padding="12" Margin="0,0,0,8" Style="{StaticResource Scheda}">
            <StackPanel>
                <TextBlock Text="3. GEOMETRIA DI CHIUSURA DELLA CAMPITURA (SCEGLI LA MODALITA)" Margin="0,0,0,6" Style="{StaticResource Etichetta}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Modalita 1: Orizzontale da Min/Max -->
                    <Border Grid.Column="0" Background="#F5F7FA" BorderBrush="#C9D3DB" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,5,0">
                        <StackPanel>
                            <Border Height="56" Margin="0,0,0,6" Style="{StaticResource Scheda}" Padding="0">
                                <Canvas Width="190" Height="56" HorizontalAlignment="Center">
                                    <Polygon Points="15,26 105,18 175,10 175,46 15,46" Fill="#DCFCE7"/>
                                    <Polyline Points="15,26 105,18 175,10" Stroke="#2B3640" StrokeThickness="2"/>
                                    <Line X1="15" Y1="46" X2="175" Y2="46" Stroke="#1F6FB2" StrokeThickness="2" StrokeDashArray="3,2"/>
                                    <!-- Pallino punto min e freccia H -->
                                    <Ellipse Canvas.Left="12" Canvas.Top="23" Width="6" Height="6" Fill="#DC2626"/>
                                    <Line X1="15" Y1="26" X2="15" Y2="46" Stroke="#DC2626" StrokeThickness="1.5"/>
                                    <TextBlock Canvas.Left="21" Canvas.Top="29" Text="H da Min/Max" FontSize="9.5" FontWeight="Bold" Foreground="#DC2626"/>
                                </Canvas>
                            </Border>
                            <RadioButton x:Name="rbModeMinMax" GroupName="BottomMode" IsChecked="True">
                                <TextBlock Text="Fondo Piatto da Min/Max" FontWeight="Bold" FontSize="12"/>
                            </RadioButton>
                            <StackPanel Margin="18,4,0,0">
                                <RadioButton x:Name="rbRefLowest" GroupName="MinMaxRef" Content="Dal punto piu BASSO" IsChecked="True" FontSize="11"/>
                                <RadioButton x:Name="rbRefHighest" GroupName="MinMaxRef" Content="Dal punto piu ALTO" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Modalita 2: Orizzontale da Livello + Offset -->
                    <Border Grid.Column="1" Background="#F5F7FA" BorderBrush="#C9D3DB" BorderThickness="1" CornerRadius="6" Padding="8" Margin="5,0,5,0">
                        <StackPanel>
                            <Border Height="56" Margin="0,0,0,6" Style="{StaticResource Scheda}" Padding="0">
                                <Canvas Width="190" Height="56" HorizontalAlignment="Center">
                                    <Polygon Points="15,22 175,10 175,44 15,44" Fill="#DCFCE7"/>
                                    <Polyline Points="15,22 175,10" Stroke="#2B3640" StrokeThickness="2"/>
                                    <!-- Linea di Livello -->
                                    <Line X1="6" Y1="32" X2="184" Y2="32" Stroke="#1F6FB2" StrokeThickness="1.2" StrokeDashArray="4,2"/>
                                    <Polygon Points="170,32 175,26 165,26" Fill="#1F6FB2"/>
                                    <!-- Linea di fondo ad offset -->
                                    <Line X1="15" Y1="44" X2="175" Y2="44" Stroke="#DC2626" StrokeThickness="2"/>
                                    <TextBlock Canvas.Left="20" Canvas.Top="31" Text="Livello +/- Offset" FontSize="9.5" FontWeight="Bold" Foreground="#1F6FB2"/>
                                </Canvas>
                            </Border>
                            <RadioButton x:Name="rbModeLevel" GroupName="BottomMode">
                                <TextBlock Text="Fondo Piatto da Livello" FontWeight="Bold" FontSize="12"/>
                            </RadioButton>
                            <StackPanel Margin="4,4,0,0">
                                <TextBlock Text="Livello di riferimento:" FontSize="10.5" Foreground="#5B6B78" Margin="0,0,0,2"/>
                                <ComboBox x:Name="cmbLevel" DisplayMemberPath="Name" Height="24" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Modalita 3: Parallelo alla pendenza -->
                    <Border Grid.Column="2" Background="#F5F7FA" BorderBrush="#C9D3DB" BorderThickness="1" CornerRadius="6" Padding="8" Margin="5,0,0,0">
                        <StackPanel>
                            <Border Height="56" Margin="0,0,0,6" Style="{StaticResource Scheda}" Padding="0">
                                <Canvas Width="190" Height="56" HorizontalAlignment="Center">
                                    <Polygon Points="15,24 105,16 175,8 175,28 105,36 15,44" Fill="#DCFCE7"/>
                                    <Polyline Points="15,24 105,16 175,8" Stroke="#2B3640" StrokeThickness="2"/>
                                    <Polyline Points="15,44 105,36 175,28" Stroke="#1F6FB2" StrokeThickness="2" StrokeDashArray="3,2"/>
                                    <Line X1="95" Y1="17" X2="95" Y2="37" Stroke="#DC2626" StrokeThickness="1.5"/>
                                    <TextBlock Canvas.Left="100" Canvas.Top="21" Text="Spessore H" FontSize="9.5" FontWeight="Bold" Foreground="#DC2626"/>
                                </Canvas>
                            </Border>
                            <RadioButton x:Name="rbModeParallel" GroupName="BottomMode">
                                <TextBlock Text="Segue la Pendenza" FontWeight="Bold" FontSize="12"/>
                            </RadioButton>
                            <StackPanel Margin="18,4,0,0">
                                <RadioButton x:Name="rbParVertical" GroupName="ParType" Content="Altezza H verticale" IsChecked="True" FontSize="11"/>
                                <RadioButton x:Name="rbParNormal" GroupName="ParType" Content="Spessore H ortogonale" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 4. Misura Altezza H / Offset da Livello -->
        <Border Grid.Row="4" Padding="12" Margin="0,0,0,8" Style="{StaticResource Scheda}">
            <StackPanel>
                <TextBlock x:Name="lblHeightTitle" Text="4. ALTEZZA H (O OFFSET RISPETTO AL LIVELLO SELEZIONATO)" Margin="0,0,0,5" Style="{StaticResource Etichetta}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtHeight" Grid.Column="0" Height="32" VerticalContentAlignment="Center" Padding="10,0" FontSize="14" FontWeight="SemiBold" Text="100 cm" BorderBrush="#C9D3DB"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button x:Name="btnPreset0" Content="0 mm" Padding="8,4" FontSize="11"/>
                        <Button x:Name="btnPreset50cm" Content="50 cm" Padding="8,4" FontSize="11"/>
                        <Button x:Name="btnPreset100cm" Content="100 cm" Padding="8,4" FontSize="11"/>
                        <Button x:Name="btnPreset150cm" Content="150 cm" Padding="8,4" FontSize="11"/>
                        <Button x:Name="btnPreset200cm" Content="200 cm" Padding="8,4" FontSize="11"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Inserisci un valore positivo in mm, cm o m (es. 1200mm, 120cm, 1.2m): la direzione (Verso il Basso / Alto) viene presa automaticamente dal punto 2." FontSize="11" Foreground="#5B6B78" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 5. Tipo Campitura e Stili Linea Differenziati -->
        <Border Grid.Row="5" Style="{StaticResource Scheda}">
            <StackPanel>
                <TextBlock Text="5. TIPO DI CAMPITURA" Style="{StaticResource Etichetta}" Margin="0,0,0,4"/>
                <ComboBox x:Name="cmbFilledRegionType" DisplayMemberPath="Name"/>
            </StackPanel>
        </Border>

        <Expander Grid.Row="6" Header="Opzioni avanzate" IsExpanded="False">
            <Border Style="{StaticResource Scheda}" Margin="0,6,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="STILE LINEA DEL PROFILO" Style="{StaticResource Etichetta}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cmbTopLineStyle" DisplayMemberPath="Name"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="STILE LINEA FIANCHI E FONDO" Style="{StaticResource Etichetta}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="cmbSideBottomLineStyle" DisplayMemberPath="Name"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="chkCropToView" Content="Taglia ai limiti sinistro e destro del ritaglio della vista" IsChecked="True" Margin="0,10,0,0"/>
                    <CheckBox x:Name="chkSelectResult" Content="Seleziona la campitura creata" IsChecked="True"/>
                </StackPanel>
            </Border>
        </Expander>

        <!-- Footer -->
        <Grid Grid.Row="7" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="lblStatus" Grid.Column="0" Text="Pronto" VerticalAlignment="Center" Foreground="#5B6B78" FontSize="12" FontWeight="Medium" TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="btnCancel" Content="Annulla" Width="90" Height="32" Margin="0,0,8,0" IsCancel="True"/>
                <Button x:Name="btnApply" Content="Crea campitura" Height="32" Style="{StaticResource Primario}" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
