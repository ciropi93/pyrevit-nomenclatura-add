<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personalizza Palette"
        Height="600" Width="720" MinHeight="460" MinWidth="620"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Background="#F5F7FA">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Intestazione}">
            <StackPanel>
                <TextBlock Text="Personalizza Palette" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Foreground="#C9D3DB" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Per ogni categoria spunta gli strumenti che compaiono in ogni famiglia (Trasforma, Forma, Seleziona, Vista, Isola). La fila fissa in alto è uguale per tutte le categorie."/>
            </StackPanel>
        </Border>

        <CheckBox Grid.Row="1" x:Name="chkAttiva" Content="Palette attiva" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#DDE3E8" BorderThickness="1" CornerRadius="6">
                <ListBox x:Name="lstCategorie" BorderThickness="0" Margin="4" FontSize="12"/>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#DDE3E8" BorderThickness="1" CornerRadius="6">
                <Grid Margin="12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" x:Name="txtConteggio" FontSize="11"
                                   Foreground="#5B6B78" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtCategoria" FontSize="14" FontWeight="SemiBold" Foreground="#2B3640"/>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="pnlComandi"/>
                    </ScrollViewer>
                    <WrapPanel Grid.Row="2" Margin="0,8,0,0" HorizontalAlignment="Right">
                        <Button x:Name="btnRipristinaCat" Content="Predefiniti"/>
                        <Button x:Name="btnCopiaTutte" Content="Copia su tutte"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock VerticalAlignment="Center" Foreground="#5B6B78" FontSize="11" TextWrapping="Wrap" Margin="0,0,260,0"
                       Text="Gli strumenti CDV (muri, sezioni, viste in tavola) compaiono sempre quando servono."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnRipristinaTutto" Content="Ripristina tutto"/>
                <Button x:Name="btnAnnulla" Content="Annulla" IsCancel="True"/>
                <Button x:Name="btnSalva" Content="Salva" Style="{StaticResource Primario}" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
