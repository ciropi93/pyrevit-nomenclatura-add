<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copia Ritaglio di Vista - CDV Tools"
        Height="720" Width="780"
        MinHeight="550" MinWidth="650"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#F8FAFC">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Source View Card -->
            <RowDefinition Height="Auto"/> <!-- Filters / Search -->
            <RowDefinition Height="*"/>    <!-- Target Views List -->
            <RowDefinition Height="Auto"/> <!-- Options -->
            <RowDefinition Height="Auto"/> <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Copia Ritaglio di Vista" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF"/>
                <TextBlock Text="Sincronizza l'estensione del ritaglio (Crop Box), forma sagomata e annotazioni tra viste compatibili" FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Source View Card -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="VISTA SORGENTE:" FontWeight="Bold" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox Grid.Column="1" x:Name="cmbSourceView" Height="28" VerticalContentAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                </Grid>

                <!-- Source Status Badges -->
                <WrapPanel Margin="0,4,0,0">
                    <Border x:Name="bdrSourceCropStatus" Background="#E0F2FE" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <TextBlock x:Name="lblSourceCropStatus" Text="Ritaglio Attivo" FontSize="11" FontWeight="SemiBold" Foreground="#0369A1"/>
                    </Border>
                    <Border x:Name="bdrSourceAnnoStatus" Background="#F1F5F9" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <TextBlock x:Name="lblSourceAnnoStatus" Text="Ritaglio Annotazioni" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                    </Border>
                    <Border x:Name="bdrSourceLevelStatus" Background="#F1F5F9" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <TextBlock x:Name="lblSourceLevelStatus" Text="Livello: -" FontSize="11" Foreground="#475569"/>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Search & Filters -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="txtSearch" Height="28" VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,8,0" FontSize="12" ToolTip="Cerca per nome vista o livello..."/>
                    <ComboBox Grid.Column="1" x:Name="cmbViewTypeFilter" Height="28" VerticalContentAlignment="Center" FontSize="12"/>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="btnSelectAll" Content="Seleziona Tutti" Padding="8,4"/>
                    <Button x:Name="btnDeselectAll" Content="Deseleziona Tutti" Padding="8,4"/>
                    <Button x:Name="btnSelectSameType" Content="Stesso Tipo" Padding="8,4"/>
                    <Button x:Name="btnSelectSameLevel" Content="Stesso Livello" Padding="8,4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Target Views List -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,0,8">
            <ListView x:Name="lstTargetViews" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="45">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Nome Vista" Width="260">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ViewName}" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Tipo" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ViewTypeName}" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Livello" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LevelName}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Stato Ritaglio" Width="160">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusBgColor}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusFgColor}" FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Options Card -->
        <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
            <WrapPanel>
                <CheckBox x:Name="chkCopyVisibility" Content="Copia visibilità contorno (Crop Visible)" IsChecked="True" Margin="0,0,16,0"/>
                <CheckBox x:Name="chkCopyAnnotation" Content="Copia ritaglio annotazione" IsChecked="True" Margin="0,0,16,0"/>
                <CheckBox x:Name="chkRemoveScopeBox" Content="Scollega Riquadro di Definizione (Scope Box)" IsChecked="True" ToolTip="Se la vista ha un Riquadro di Definizione assegnato, lo scollega per poter modificare il ritaglio"/>
            </WrapPanel>
        </Border>

        <!-- Footer Actions -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="lblSelectionSummary" Text="0 viste selezionate" VerticalAlignment="Center" FontSize="12" Foreground="#64748B" FontWeight="Medium"/>
            <Button Grid.Column="1" x:Name="btnCancel" Content="Annulla" Width="90" Height="32" Margin="0,0,8,0"/>
            <Button Grid.Column="2" x:Name="btnApply" Content="Applica Ritaglio" Width="140" Height="32" Background="#0F172A" Foreground="#FFFFFF" FontWeight="Bold"/>
        </Grid>
    </Grid>
</Window>
