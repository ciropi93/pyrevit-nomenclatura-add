<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profondità sezione"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Background="#F5F7FA">

    <StackPanel Margin="16">
        <Border Style="{StaticResource Intestazione}">
            <StackPanel>
                <TextBlock Text="Profondità sezione" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                <TextBlock x:Name="lblVista" Text="-" FontSize="12" Foreground="#DCE9F5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Scheda}">
            <StackPanel>
                <TextBlock Text="FINO A CHE PROFONDITÀ (M)" Style="{StaticResource Etichetta}" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtDepthValue" Height="32" FontSize="14" FontWeight="SemiBold"
                             ToolTip="Distanza dalla linea di sezione fino a cui si vede lo sfondo grigio"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button x:Name="btnPiu5" Content="+5 m" Padding="8,4" FontSize="11"/>
                        <Button x:Name="btnPiu10" Content="+10 m" Padding="8,4" FontSize="11"/>
                        <Button x:Name="btnPiu20" Content="+20 m" Padding="8,4" FontSize="11"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="lblAnteprima" Text="" FontSize="11" Foreground="#5B6B78" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Expander x:Name="expOpzioni" Header="Opzioni avanzate" IsExpanded="False">
            <Border Style="{StaticResource Scheda}" Margin="0,6,0,0">
                <StackPanel>
                    <CheckBox x:Name="chkHalftone" IsChecked="True" Content="Sfondo a mezzitoni"/>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="chkGreyColor" IsChecked="True" Content="Linee grigie sottili, grigio RGB" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtGreyRgb" Text="140" Width="48" Margin="8,0,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="chkHideCutPatterns" IsChecked="True" Content="Nascondi i retini di taglio nello sfondo"/>
                    <CheckBox x:Name="chkSyncSheet" IsChecked="True" Content="Metti e allinea lo sfondo anche in tavola"/>
                </StackPanel>
            </Border>
        </Expander>

        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnSyncAll" Content="Sincronizza tutte" HorizontalAlignment="Left" Height="32"
                    ToolTip="Riallinea gli sfondi di tutte le sezioni del progetto"/>
            <Button Grid.Column="1" x:Name="btnCancel" Content="Annulla" Width="90" Height="32" Margin="0,0,8,0" IsCancel="True"/>
            <Button Grid.Column="2" x:Name="btnApply" Content="Crea sfondo" Height="32" Style="{StaticResource Primario}" IsDefault="True"/>
        </Grid>
    </StackPanel>
</Window>
