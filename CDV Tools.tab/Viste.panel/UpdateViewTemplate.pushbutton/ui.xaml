<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aggiorna modello di vista"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Background="#F5F7FA">

    <StackPanel Margin="16">
        <Border Style="{StaticResource Intestazione}">
            <StackPanel>
                <TextBlock Text="Aggiorna modello di vista" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                <TextBlock x:Name="lblVista" Text="-" FontSize="12" Foreground="#DCE9F5" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Caso 1: la vista usa un modello -> si sgancia per modificarla -->
        <StackPanel x:Name="pnlSgancia">
            <Border Style="{StaticResource Scheda}">
                <StackPanel>
                    <TextBlock Text="Questa vista usa il modello" FontSize="13"/>
                    <TextBlock x:Name="lblModelloAttuale" Text="-" FontSize="14" FontWeight="Bold" Margin="0,2,0,8"/>
                    <TextBlock Style="{StaticResource Nota}" Margin="0" Text="La sua grafica viene dal modello. Per cambiarla: sgancia il modello, modifica la vista, poi rilancia questo comando: il modello sarà già proposto e la vista verrà riagganciata."/>
                </StackPanel>
            </Border>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnAltro" Content="Aggiorna un altro modello..." HorizontalAlignment="Left" Height="32"/>
                <Button Grid.Column="1" x:Name="btnCancel1" Content="Annulla" Width="90" Height="32" Margin="0,0,8,0" IsCancel="True"/>
                <Button Grid.Column="2" x:Name="btnSgancia" Content="Sgancia per modificare" Height="32" Style="{StaticResource Primario}" IsDefault="True"/>
            </Grid>
        </StackPanel>

        <!-- Caso 2: la vista non ha modello -> quale modello aggiornare (o crearne uno) -->
        <StackPanel x:Name="pnlScegli" Visibility="Collapsed">
            <TextBox x:Name="txtSearch" Margin="0,0,0,8" ToolTip="Cerca modello"/>
            <ListBox x:Name="lstModelli" MaxHeight="280" Margin="0,0,0,8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding Dettaglio}" FontSize="11" FontWeight="Normal"
                                       Foreground="#5B6B78" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="pnlNome" Visibility="Collapsed" Margin="0,0,0,8">
                <TextBlock Text="NOME DEL NUOVO MODELLO" Style="{StaticResource Etichetta}" Margin="0,0,0,4"/>
                <TextBox x:Name="txtNewTemplateName"/>
            </StackPanel>

            <TextBlock x:Name="lblNota" Style="{StaticResource Nota}" Text=""/>
            <CheckBox x:Name="chkReassign" IsChecked="True" Content="Riaggancia questa vista al modello" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnCancel" Content="Annulla" Width="90" Height="32" Margin="0,0,8,0" IsCancel="True"/>
                <Button x:Name="btnApply" Content="Scegli un modello" Height="32" Style="{StaticResource Primario}"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
