<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aggiorna Modello di Vista da Vista"
        Height="680" Width="760"
        MinHeight="520" MinWidth="650"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Background="#F5F7FA">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Source View Card -->
            <RowDefinition Height="*"/>    <!-- Target Template Card -->
            <RowDefinition Height="Auto"/> <!-- Options Card -->
            <RowDefinition Height="Auto"/> <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource Intestazione}">
            <StackPanel>
                <TextBlock Text="Aggiorna Modello di Vista da Vista" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                <TextBlock Text="Trasferisce le modifiche e le impostazioni grafiche della vista corrente al modello di vista desiderato" FontSize="12" Foreground="#DCE9F5" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Source View Card -->
        <Border Grid.Row="1" Padding="14" Margin="0,0,0,10" Style="{StaticResource Scheda}">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="VISTA SORGENTE:" VerticalAlignment="Center" Margin="0,0,12,0" Style="{StaticResource Etichetta}"/>
                    <ComboBox Grid.Column="1" x:Name="cmbSourceView" Height="28" VerticalContentAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                </Grid>

                <!-- Source Status Badges -->
                <WrapPanel Margin="0,4,0,0">
                    <Border Background="#E8F1FA" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <TextBlock x:Name="lblSourceType" Text="Tipo: -" FontSize="11" FontWeight="SemiBold" Foreground="#185A91"/>
                    </Border>
                    <Border x:Name="bdrSourceTemplate" Background="#FEF3C7" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <TextBlock x:Name="lblSourceTemplate" Text="Modello: Nessuno (Sganciato)" FontSize="11" FontWeight="SemiBold" Foreground="#B45309"/>
                    </Border>
                    <Border Background="#EEF2F5" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <TextBlock x:Name="lblSourceOverrides" Text="Sovrascritture: -" FontSize="11" Foreground="#4A5866"/>
                    </Border>
                    <Border Background="#EEF2F5" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <TextBlock x:Name="lblSourceFilters" Text="Filtri: -" FontSize="11" Foreground="#4A5866"/>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Target Template Card -->
        <Border Grid.Row="2" Padding="14" Margin="0,0,0,10" Style="{StaticResource Scheda}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Mode Selection -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="AZIONE:" VerticalAlignment="Center" Margin="0,0,16,0" Style="{StaticResource Etichetta}"/>
                    <RadioButton x:Name="rbUpdateExisting" Content="Aggiorna Modello Esistente" IsChecked="True"/>
                    <RadioButton x:Name="rbCreateNew" Content="Crea Nuovo Modello da questa Vista"/>
                </StackPanel>

                <!-- Existing Template Panel -->
                <StackPanel Grid.Row="1" x:Name="pnlUpdateExisting">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="txtSearchTemplate" Height="28" VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,8,0" FontSize="12" ToolTip="Cerca modello per nome..."/>
                        <ComboBox Grid.Column="1" x:Name="cmbTypeFilter" Height="28" VerticalContentAlignment="Center" FontSize="12"/>
                    </Grid>

                    <TextBlock Text="MODELLO DI VISTA DA AGGIORNARE:" Margin="0,4,0,4" Style="{StaticResource Etichetta}"/>
                    <ComboBox x:Name="cmbTargetTemplate" Height="30" VerticalContentAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Create New Template Panel -->
                <StackPanel Grid.Row="1" x:Name="pnlCreateNew" Visibility="Collapsed">
                    <TextBlock Text="NOME DEL NUOVO MODELLO DI VISTA:" Margin="0,4,0,4" Style="{StaticResource Etichetta}"/>
                    <TextBox x:Name="txtNewTemplateName" Height="30" VerticalContentAlignment="Center" Padding="8,0" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Template Details & Usage Warning -->
                <Border Grid.Row="3" Background="#F5F7FA" BorderBrush="#DDE3E8" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="IMPATTO SUL MODELLO:" Margin="0,0,0,4" Style="{StaticResource Etichetta}"/>
                        <TextBlock x:Name="lblTemplateUsage" Text="Seleziona un modello di vista..." FontSize="12" Foreground="#2B3640" TextWrapping="Wrap"/>
                        <TextBlock x:Name="lblTemplateWarning" Text="Tutte le viste del progetto che utilizzano questo modello erediteranno all'istante le nuove impostazioni." FontSize="11" Foreground="#185A91" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Options Card -->
        <Border Grid.Row="3" Padding="12,8" Margin="0,0,0,10" Style="{StaticResource Scheda}">
            <StackPanel>
                <CheckBox x:Name="chkReassign" Content="Riassegna questo Modello di Vista alla vista corrente (riaggancia la vista al termine)" IsChecked="True" FontWeight="SemiBold" Foreground="#185A91"/>
            </StackPanel>
        </Border>

        <!-- Footer Actions -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="lblSummary" Text="Pronto per l'aggiornamento" VerticalAlignment="Center" FontSize="12" Foreground="#5B6B78"/>
            <Button Grid.Column="1" x:Name="btnCancel" Content="Annulla" Width="90" Height="32" Margin="0,0,8,0" IsCancel="True"/>
            <Button Grid.Column="2" x:Name="btnApply" Content="Aggiorna Modello" Width="150" Height="32" Style="{StaticResource Primario}"/>
        </Grid>
    </Grid>
</Window>
