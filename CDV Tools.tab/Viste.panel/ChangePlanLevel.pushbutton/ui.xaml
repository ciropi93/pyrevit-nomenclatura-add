<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cambia Livello Pianta"
        Height="560" Width="640"
        MinHeight="500" MinWidth="560"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Background="#F5F7FA">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource Intestazione}">
            <StackPanel>
                <TextBlock Text="Cambia Livello Associato della Pianta" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                <TextBlock Text="Sposta o duplica una vista di pianta su un altro livello preservando grafica, ritaglio, annotazioni 2D e tavola" FontSize="12" Foreground="#DCE9F5" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Source View Card -->
        <Border Grid.Row="1" Padding="14" Margin="0,0,0,10" Style="{StaticResource Scheda}">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="VISTA DI PIANTA:" VerticalAlignment="Center" Style="{StaticResource Etichetta}" Margin="0"/>
                    <ComboBox Grid.Column="1" x:Name="cmbSourceView" Height="28" VerticalContentAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                </Grid>

                <WrapPanel Margin="0,2,0,0">
                    <Border Background="#E8F1FA" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <TextBlock x:Name="lblCurrentLevel" Text="Livello attuale: -" FontSize="11" FontWeight="SemiBold" Foreground="#185A91"/>
                    </Border>
                    <Border Background="#EEF2F5" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <TextBlock x:Name="lblViewType" Text="Tipo: -" FontSize="11" Foreground="#4A5866"/>
                    </Border>
                    <Border x:Name="bdrSheetStatus" Background="#DCFCE7" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                        <TextBlock x:Name="lblSheetStatus" Text="Tavola: -" FontSize="11" FontWeight="SemiBold" Foreground="#15803D"/>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Target Level & Name Card -->
        <Border Grid.Row="2" Padding="14" Margin="0,0,0,10" Style="{StaticResource Scheda}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="SELEZIONA NUOVO LIVELLO DI DESTINAZIONE:" Margin="0,0,0,6" Style="{StaticResource Etichetta}"/>

                <ListBox Grid.Row="1" x:Name="lstLevels" BorderBrush="#C9D3DB" BorderThickness="1" FontSize="12" Padding="4"/>

                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="NOME VISTA:" VerticalAlignment="Center" Style="{StaticResource Etichetta}" Margin="0"/>
                    <TextBox Grid.Column="1" x:Name="txtNewViewName" Height="28" VerticalContentAlignment="Center" Padding="6,0" FontSize="12" FontWeight="SemiBold" BorderBrush="#C9D3DB"/>
                    <Button Grid.Column="2" x:Name="btnSuggestName" Content="Usa nome livello" Margin="6,0,0,0" Padding="10,4" FontSize="11"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Options Card -->
        <Border Grid.Row="3" Padding="14" Margin="0,0,0,12" Style="{StaticResource Scheda}">
            <StackPanel>
                <WrapPanel Margin="0,0,0,6">
                    <RadioButton x:Name="rbReplaceView" Content="Sostituisci la vista attuale (elimina la vecchia)" IsChecked="True"/>
                    <RadioButton x:Name="rbDuplicateView" Content="Duplica sul nuovo livello (mantieni entrambe)"/>
                </WrapPanel>
                <WrapPanel>
                    <CheckBox x:Name="chkCopy2D" Content="Trasferisci elementi 2D (quote, testi, etichette, linee, campiture)" IsChecked="True" Margin="0,3,20,3"/>
                    <CheckBox x:Name="chkCopyHidden" Content="Trasferisci elementi 3D nascosti manualmente nella vista" IsChecked="False" Margin="0,3,0,3"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="lblStatusHint" Text="Pronto." FontSize="11" Foreground="#5B6B78" VerticalAlignment="Center"/>
            <Button Grid.Column="1" x:Name="btnCancel" Content="Annulla" Width="100" Margin="0,0,8,0" IsCancel="True"/>
            <Button Grid.Column="2" x:Name="btnApply" Content="Cambia Livello" Width="150" Style="{StaticResource Primario}" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
