<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cambia livello"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Background="#F5F7FA">

    <StackPanel Margin="16">
        <Border Style="{StaticResource Intestazione}">
            <StackPanel>
                <TextBlock Text="Cambia livello" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                <TextBlock x:Name="lblVista" Text="-" FontSize="12" Foreground="#DCE9F5" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <ListBox x:Name="lstLevels" MaxHeight="300" Margin="0,0,0,10">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="IsEnabled" Value="{Binding Abilitato}"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Nome}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Dettaglio}" FontSize="11" FontWeight="Normal"
                                   Foreground="#5B6B78" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Style="{StaticResource Nota}"
                   Text="La pianta passa al livello scelto con grafica, ritaglio, annotazioni e posto in tavola."/>

        <Expander x:Name="expOpzioni" Header="Opzioni" IsExpanded="False">
            <Border Style="{StaticResource Scheda}" Margin="0,6,0,0">
                <StackPanel>
                    <RadioButton x:Name="rbReplaceView" GroupName="Modo" IsChecked="True" Content="Sposta la pianta (resta una sola vista)"/>
                    <RadioButton x:Name="rbDuplicateView" GroupName="Modo" Content="Duplica (tieni anche questa pianta)"/>
                    <TextBlock Text="NOME DELLA VISTA" Style="{StaticResource Etichetta}" Margin="0,10,0,4"/>
                    <TextBox x:Name="txtNewViewName"/>
                    <CheckBox x:Name="chkCopy2D" IsChecked="True" Margin="0,10,0,0" Content="Porta anche quote, testi e linee 2D"/>
                    <CheckBox x:Name="chkCopyHidden" IsChecked="True" Content="Porta anche gli elementi nascosti a mano"/>
                </StackPanel>
            </Border>
        </Expander>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button x:Name="btnCancel" Content="Annulla" Width="90" Height="32" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="btnApply" Content="Scegli un livello" Height="32" Style="{StaticResource Primario}" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
