<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crea filtro"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Background="#F5F7FA">

    <StackPanel Margin="16">
        <Border Style="{StaticResource Intestazione}">
            <StackPanel>
                <TextBlock Text="Crea filtro" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                <TextBlock x:Name="lblSelezione" Text="-" FontSize="12" Foreground="#DCE9F5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <TextBlock Text="FILTRA PER" Style="{StaticResource Etichetta}" Margin="0,0,0,4"/>
        <ListBox x:Name="lstRegole" MaxHeight="260" Margin="0,0,0,10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Nome}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Dettaglio}" FontWeight="Normal" Foreground="#185A91"
                                   Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="NOME DEL FILTRO" Style="{StaticResource Etichetta}" Margin="0,0,0,4"/>
        <TextBox x:Name="txtFilterName" Margin="0,0,0,8"/>
        <TextBlock x:Name="lblDove" Style="{StaticResource Nota}" Text=""/>

        <Expander x:Name="expOpzioni" Header="Opzioni avanzate" IsExpanded="False">
            <Border Style="{StaticResource Scheda}" Margin="0,6,0,0">
                <StackPanel>
                    <CheckBox x:Name="chkAddToActiveView" IsChecked="True" Content="Aggiungi il filtro alla vista attiva"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <CheckBox x:Name="chkApplyColor" IsChecked="True" Content="Colora" VerticalAlignment="Center"/>
                        <ComboBox x:Name="cmbColor" Width="140" Margin="8,0,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="chkSolidFill" IsChecked="False" Content="Con retino pieno"/>
                    <CheckBox x:Name="chkHalftone" IsChecked="False" Content="A mezzitoni"/>
                    <CheckBox x:Name="chkVisibility" IsChecked="True" Content="Visibili (spegni per nasconderli)"/>
                </StackPanel>
            </Border>
        </Expander>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button x:Name="btnCancel" Content="Annulla" Width="90" Height="32" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="btnCreateFilter" Content="Crea filtro" Height="32" Style="{StaticResource Primario}" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
