<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crea Filtro di Vista da Selezione"
        Height="820" Width="760"
        MinHeight="650" MinWidth="640"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Background="#F5F7FA">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource Intestazione}">
            <StackPanel>
                <TextBlock Text="Crea Filtro di Vista da Selezione" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                <TextBlock Text="Analisi automatica dei parametri comuni degli elementi selezionati e generazione rapida del filtro" FontSize="12" Foreground="#DCE9F5" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Card 1: Elementi e Categorie -->
        <Border Grid.Row="1" Padding="14" Margin="0,0,0,12" Style="{StaticResource Scheda}">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CATEGORIE DEGLI ELEMENTI SELEZIONATI" Style="{StaticResource Etichetta}" Margin="0"/>
                    <TextBlock Grid.Column="1" x:Name="lblSelectionSummary" Text="0 elementi selezionati" FontSize="11" Foreground="#1F6FB2" FontWeight="SemiBold"/>
                </Grid>
                <ItemsControl x:Name="icCategories">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#EEF2F5" BorderBrush="#C9D3DB" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,4">
                                <CheckBox IsChecked="{Binding IsIncluded}" Content="{Binding DisplayName}" FontWeight="Medium" Margin="0"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Card 2: Parametri e Regole Suggerite -->
        <Border Grid.Row="2" Padding="14" Margin="0,0,0,12" Style="{StaticResource Scheda}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="PARAMETRI E REGOLE CONSIGLIATE" Style="{StaticResource Etichetta}" Margin="0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <RadioButton x:Name="rbAnd" Content="Tutte le regole (AND)" IsChecked="True"/>
                        <RadioButton x:Name="rbOr" Content="Almeno una regola (OR)"/>
                    </StackPanel>
                </Grid>

                <TextBox x:Name="txtSearchParam" Grid.Row="1" Height="30" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,8" FontSize="12"/>

                <!-- ListView Parametri -->
                <ListView x:Name="lvParameters" Grid.Row="2" BorderThickness="1" BorderBrush="#DDE3E8" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="#FFFFFF">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0,0,0,1" BorderBrush="#EEF2F5" Padding="4,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Checkbox Selezione Regola -->
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                                    
                                    <!-- Nome Parametro e Tipo/Istanza -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding ParamName}" FontWeight="SemiBold" Foreground="#2B3640" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ScopeText}" Foreground="#8C9AA6" FontSize="10"/>
                                    </StackPanel>
                                    
                                    <!-- Badge Match (Identico o Multiplo) -->
                                    <Border Grid.Column="2" Background="{Binding MatchBgColor}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding MatchText}" Foreground="{Binding MatchFgColor}" FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                    
                                    <!-- Operatore -->
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding AvailableOperators}" SelectedItem="{Binding SelectedOperator, Mode=TwoWay}" Height="26" VerticalContentAlignment="Center" FontSize="11" Margin="0,0,6,0"/>
                                    
                                    <!-- Valore Regola -->
                                    <TextBox Grid.Column="4" Text="{Binding RuleValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center" Padding="4,0" FontSize="11"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Card 3: Configurazione Filtro e Vista -->
        <Border Grid.Row="3" Padding="14" Margin="0,0,0,12" Style="{StaticResource Scheda}">
            <StackPanel>
                <TextBlock Text="CONFIGURAZIONE FILTRO E VISTA" Margin="0,0,0,8" Style="{StaticResource Etichetta}"/>
                
                <!-- Nome Filtro -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Nome Filtro:" VerticalAlignment="Center" FontWeight="Medium" FontSize="12" Foreground="#3C4650"/>
                    <TextBox x:Name="txtFilterName" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="6,0" FontSize="12"/>
                    <Button x:Name="btnRegenName" Grid.Column="2" Content="Suggerisci Nome" Margin="6,0,0,0" Padding="8,4" FontSize="11"/>
                </Grid>

                <!-- Opzioni Vista -->
                <CheckBox x:Name="chkAddToActiveView" Content="Aggiungi il filtro alla vista attiva" IsChecked="True" FontWeight="SemiBold" Margin="0,0,0,6"/>
                
                <Border Background="#F5F7FA" BorderBrush="#DDE3E8" BorderThickness="1" CornerRadius="6" Padding="10,6">
                    <WrapPanel Orientation="Horizontal">
                        <CheckBox x:Name="chkApplyColor" Content="Sovrascrivi Colore:" IsChecked="True" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="cmbColor" Width="110" Height="26" VerticalContentAlignment="Center" Margin="0,0,16,0" FontSize="11"/>
                        <CheckBox x:Name="chkSolidFill" Content="Retino Solido" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <CheckBox x:Name="chkHalftone" Content="Mezzitoni" IsChecked="False" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <CheckBox x:Name="chkVisibility" Content="Visibile" IsChecked="True" VerticalAlignment="Center"/>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="lblRulesCount" Grid.Column="0" Text="0 regole selezionate" VerticalAlignment="Center" Foreground="#5B6B78" FontSize="12" FontWeight="Medium"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="btnCancel" Content="Annulla" Width="90" Height="34" Margin="0,0,8,0" IsCancel="True"/>
                <Button x:Name="btnCreateFilter" Content="Crea e Applica Filtro" Height="34" Padding="16,0" Style="{StaticResource Primario}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
